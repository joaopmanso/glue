{
  "name": "glue",
  "version": "0.1.0",
  "private": true,
  "description": "GLUE, Global Library Unified Exporter: a local-first DJ library that glues DJ apps together",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "home:ui": "vite build --config home/vite.config.ts",
    "home:dev": "vite --config home/vite.config.ts",
    "home:preview": "vite preview --config home/vite.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.11.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.6",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "mediabunny": "^1.60.0",
    "sql.js": "^1.14.2",
    "three": "^0.186.1",
    "threejs-visualisers": "github:festanqueiro/threejs-visualisers#v0.1.2"
  },
  "allowScripts": {
    "github:festanqueiro/threejs-visualisers#3a85cac1d9db9d8c3ba30a5f65d90831f137944b": true
  }
}
