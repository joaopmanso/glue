{"nodes": [{"id": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "label": "ADR 0194: GLUE doesn't write into Engine DJ", "file_type": "rationale", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ 5.3.0.7 rebuilt the Collection's database; GLUE Home 0.79's sync took it for changes and deleted the user's playlists. This is the third time GLUE's writes left Engine DJ unusable, each time because GLUE kept a model of a private database Engine DJ can change at any time. Decision: writes off unless engineWrites is set; reading stays."}, {"id": "vault_adr_0194_engine_writes_setting", "label": "engineWrites setting (off by default)", "file_type": "concept", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home writes nothing into Engine DJ unless its settings say engineWrites: true. There is no button; the code stays, tested with the flag on."}, {"id": "vault_adr_0194_alt_fix_sync", "label": "Alternative: fix the sync for Engine DJ 5.3", "file_type": "rationale", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forgetting what it remembered and taking the new database as the base would work only until Engine DJ changes its database again; the third breakage says the approach is wrong. Rejected."}, {"id": "vault_adr_0194_alt_djplaylists_false", "label": "Alternative: djPlaylists false", "file_type": "rationale", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The existing pause only stopped playlists; cues, grids and song info were still written. Rejected."}, {"id": "vault_adr_0194_alt_stop_home", "label": "Alternative: Stop in GLUE Home", "file_type": "rationale", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stops everything else too: the analysis, the library and other devices. Rejected."}, {"id": "vault_adr_0194_own_engine_library", "label": "Next: GLUE's own Engine DJ library", "file_type": "concept", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE keeps its own Engine DJ library, as a drive's is, holding only GLUE's playlists and their songs, so it writes its own database and never Engine DJ's Collection. To be designed with the user; first check how Engine DJ 5.3 finds a drive's library."}, {"id": "vault_adr_0194_cache_before_writes", "label": "GLUE Home's Engine DJ cache must be let go before writes return", "file_type": "rationale", "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cache (dj/...) holds the last agreed state from before Engine DJ 5.3, the GLUE folder's ids and waiting edits; without letting it go, a later sync would act on the old state again."}], "edges": [{"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "vault_adr_0170_engine_dj_kept_in_step_both_ways_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "crates_glue_engine_tests_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "target": "e2e_homemode_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_engine_writes_setting", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_alt_fix_sync", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_alt_djplaylists_false", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_alt_stop_home", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_cache_before_writes", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0194_own_engine_library", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "hyper_engine_dj_writes_off", "label": "Engine DJ writes switched off", "nodes": ["vault_adr_0194_engine_writes_setting", "vault_system_engine_dj_writes_off", "src_help_dj_libraries_engine_dj_paused"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0194-glue-doesnt-write-into-engine-dj.md"}]}