{"nodes": [{"id": "vault_system_md_system_overview", "label": "SYSTEM.md: How GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "engine_dj_collection_concept", "label": "Engine DJ Collection database", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ's Collection is the computer's database in the Music folder (C:), holding the master playlist tree. GLUE Home reads from it and writes changes there first, then propagates to drive copies."}, {"id": "engine_dj_drive_copies_concept", "label": "Engine DJ drive database copies", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each drive (F:, G:, etc.) holds its own copy of Engine DJ's playlist database with the same ids as the Collection. Drive copies hold only playlists with that drive's songs or playlists already there."}, {"id": "dj_two_way_sync_mechanism", "label": "Engine DJ two-way sync", "file_type": "mechanism", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home keeps Engine DJ in sync both ways: cues, loops, beat grid and playlists edited in GLUE are written to Engine DJ while it's closed; changes made in Engine DJ come back into GLUE. Opt-in per library, backed up before writing."}, {"id": "dj_library_following_mechanism", "label": "DJ library following", "file_type": "mechanism", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home follows every collection's DJ libraries every 5s by date (rekordbox XML, Traktor NML, Apple Music XML, Serato, Engine DJ m.db, M3U), reading changed ones again."}, {"id": "glue_playlists_in_engine_dj_glue_folder", "label": "GLUE's playlists in Engine DJ GLUE folder", "file_type": "mechanism", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE's own playlists are kept in Engine DJ's top-level GLUE folder, managed two-way (ADR 0180): merged three ways, deleted ones asked, turned off to remove them."}, {"id": "main_dj_library_concept", "label": "Main DJ library", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One DJ library per computer marked as main (ADR 0169). Its beat grids and cues are a song's default; changes in GLUE or the app are synced both ways."}, {"id": "song_no_file_linked_mechanism", "label": "Songs with no file linked", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DJ library records whose files are gone are matched to the library's songs with a certainty (ADR 0124) and linked: the song takes their playlists and what was set on them."}, {"id": "dj_playlists_stay_in_dj_collection", "label": "DJ playlists stay in DJ collection", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A DJ app's playlists stay in its DJ collection (ADR 0178): GLUE's copies are imports, not kept in step both ways as before. One exception: GLUE's own playlists in the app's GLUE folder are kept in step (ADR 0180)."}], "edges": [{"source": "vault_system_md_system_overview", "target": "engine_dj_collection_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "engine_dj_drive_copies_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "dj_two_way_sync_mechanism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "dj_library_following_mechanism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "glue_playlists_in_engine_dj_glue_folder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "main_dj_library_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "song_no_file_linked_mechanism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_md_system_overview", "target": "dj_playlists_stay_in_dj_collection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "dj_two_way_sync_mechanism", "target": "engine_dj_collection_concept", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "dj_two_way_sync_mechanism", "target": "cues_loops_grid_storage", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "glue_playlists_in_engine_dj_glue_folder", "target": "engine_dj_collection_concept", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "engine_dj_sync_flow", "label": "Engine DJ two-way sync flow", "nodes": ["engine_dj_collection_concept", "engine_dj_drive_copies_concept", "dj_two_way_sync_mechanism"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "vault/SYSTEM.md"}, {"id": "glue_playlist_management_flow", "label": "GLUE playlist management in Engine DJ", "nodes": ["glue_playlists_in_engine_dj_glue_folder", "engine_dj_collection_concept", "dj_playlists_stay_in_dj_collection"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/SYSTEM.md"}, {"id": "dj_library_linking_flow", "label": "DJ library following and record linking", "nodes": ["dj_library_following_mechanism", "main_dj_library_concept", "song_no_file_linked_mechanism"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/SYSTEM.md"}]}