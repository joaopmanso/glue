{"nodes": [{"id": "vault_adr_0139_a_socket_for_background_loads_and_a_list_that_stays_put_decision", "label": "ADR 0139: A socket for background loads and a list that stays put", "file_type": "rationale", "source_file": "vault/adr/0139-a-socket-for-background-loads-and-a-list-that-stays-put.md", "rationale": "Supersedes ADR 0138's gate for GLUE Home 0.42+. Introduces WebSocket on separate port for numbered cache reads (spectrograms, waveforms, details), allowing rows to stay in place when data loads by preserving list position despite row changes. Fixes user-reported playlist scrolling issue."}, {"id": "websocket_cache_protocol", "label": "WebSocket for GLUE Home cache reads", "file_type": "mechanism", "source_file": "vault/adr/0139-a-socket-for-background-loads-and-a-list-that-stays-put.md", "rationale": "GLUE Home 0.42+: WebSocket on 127.0.0.1 separate port for numbered cache file requests. Reads 6 at a time, can be cancelled. Binary answers (request number, found, bytes). Frees HTTP connections for playing."}, {"id": "scroll_position_persistence", "label": "List stays put when rows change", "file_type": "mechanism", "source_file": "vault/adr/0139-a-socket-for-background-loads-and-a-list-that-stays-put.md", "rationale": "Table remembers song at top of window and position in row. When rows change (same view/sort/filters/search) and user didn't change view, song restored to same position before drawing. If song leaves list, window stays put."}, {"id": "src_platform_homeSocket_code", "label": "src/platform/homeSocket.ts", "file_type": "code", "source_file": "vault/adr/0139-a-socket-for-background-loads-and-a-list-that-stays-put.md"}, {"id": "home_src_tauri_src_ws_code", "label": "home/src-tauri/src/ws.rs", "file_type": "code", "source_file": "vault/adr/0139-a-socket-for-background-loads-and-a-list-that-stays-put.md"}], "edges": [{"source": "vault_adr_0139_a_socket_for_background_loads_and_a_list_that_stays_put_decision", "target": "vault_system_document", "relation":