{"nodes": [{"id": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "label": "ADR 0209: Draw the song's menu as labelled tiles round the pointer; bring a song into view only when none of it shows", "file_type": "rationale", "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user found the round buttons with labels underneath unprofessional and asked for a more professional look, not all round. Choosing a song scrolled the timeline to its start whenever the start was off screen, so the pointer jumped; the check also ran on every step of a drag. Decision: labelled tiles (icon and word, 28 px, quiet glass) in fixed spots round the pointer; bring into view only when none of the choice shows, never during a drag. Supersedes ADR 0208's round buttons and ADR 0201's bring-into-view."}, {"id": "vault_adr_0209_the_set_menu_as_labelled_tiles_spot", "label": "Fixed tile spots round the pointer (SPOT)", "file_type": "concept", "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each tile has one fixed place: north and south centred 76 px away, the diagonals 39 px up or down, east and west at the pointer's height; rows never overlap."}, {"id": "vault_adr_0209_the_set_menu_as_labelled_tiles_bring_into_view", "label": "Bring into view only when none of it shows", "file_type": "concept", "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes the jump: a song chosen while zoomed past its start must not scroll the timeline; the songs' places are read untracked and only when the choice changes."}], "edges": [{"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "target": "vault_adr_0208_the_set_menu_is_only_buttons_at_the_pointer_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "target": "vault_adr_0201_a_set_shaped_by_hand_and_heard_live_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "target": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "target": "e2e_sets_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_spot", "target": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0209_the_set_menu_as_labelled_tiles_bring_into_view", "target": "vault_adr_0209_the_set_menu_as_labelled_tiles_decision", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0209-the-set-menu-as-labelled-tiles.md", "source_location": null, "weight": 1.0}], "hyperedges": []}