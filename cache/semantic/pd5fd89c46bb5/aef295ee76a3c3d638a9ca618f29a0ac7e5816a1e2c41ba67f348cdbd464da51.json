{"nodes": [{"id": "src_help_dj_libraries_article", "label": "Help: DJ libraries", "file_type": "document", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dj_library_import_concept", "label": "DJ library importing", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": "lines 11-12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE supports importing from Rekordbox XML, Engine DJ m.db, Serato database, Traktor collection, Apple Music library, and M3U playlists"}, {"id": "dj_library_live_follow_concept", "label": "DJ libraries kept up to date (followed live)", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": "lines 15-18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When GLUE Home runs, it finds libraries in music folders, reads them on demand, and follows their changes within seconds. A dot indicates a library is followed live."}, {"id": "main_dj_library_concept", "label": "Main DJ library", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": "lines 20-21", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The main DJ library's beat grids and cues become every song's by default. What the user sets in GLUE takes precedence. It's the library GLUE keeps in step with both ways."}, {"id": "engine_dj_sync_both_ways_concept", "label": "Engine DJ kept in step both ways", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": "lines 23-30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hot cues, saved loops, and beat grids set in GLUE are written to Engine DJ, and changes in Engine DJ come into GLUE. GLUE Home writes only when Engine DJ is closed. Playlists 