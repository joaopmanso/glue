{"nodes": [{"id": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "label": "ADR 0184: Turn off the folder repair in Engine DJ's databases", "file_type": "document", "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After GLUE Home 0.74.0's first sync, Engine DJ locked every playlist for the user. The repair had been checked only on copies, so the rule misses something Engine DJ checks. Decision: 0.74.1 stops calling the repair; the code stays to be looked into against the user's databases; the user restores the backups GLUE Home made before the repair."}, {"id": "engine_dj_folder_lock_after_repair", "label": "Engine DJ locked every playlist after the folder repair", "file_type": "rationale", "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the first sync of GLUE Home 0.74.0 the user could create and name playlists, but not move, rename, delete or add songs. Cause not known; the copy tests did not capture what Engine DJ checks. Lesson: changes to Engine DJ's databases inferred but not seen must be tried in Engine DJ on a copy first."}], "edges": [{"source": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "target": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "target": "enginedj_fix_folders", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "target": "folders_own", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "weight": 1.0}, {"source": "engine_dj_folder_lock_after_repair", "target": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "engine_dj_folder_repair_flow", "label": "Engine DJ folder repair: shipped in 0.74.0, turned off in 0.74.1", "nodes": ["vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "enginedj_fix_folders", "vault_adr_0184_engine_dj_folder_repair_turned_off_decision"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0184-engine-dj-folder-repair-turned-off.md"}]}