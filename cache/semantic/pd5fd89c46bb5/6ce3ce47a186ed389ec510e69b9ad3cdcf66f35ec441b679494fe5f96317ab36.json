{"nodes": [{"id": "vault_adr_0159_glue_homes_first_run_and_its_window_signed_in_decision", "label": "ADR 0159: GLUE Home's first run, a GLUE folder always offered, and its window signed in by GLUE Home", "file_type": "rationale", "source_file": "vault/adr/0159-glue-homes-first-run-and-its-window-signed-in.md"}, {"id": "first_run_guide_mechanism", "label": "GLUE Home's first-run guide", "file_type": "rationale", "source_file": "vault/adr/0159-glue-homes-first-run-and-its-window-signed-in.md", "rationale": "Guide at the top of GLUE Home's window (until finished or hidden; setupDone in settings). Steps: the account (optional), GLUE folder location, incoming folder, start with computer, Open GLUE library."}, {"id": "window_sign_in_mechanism", "label": "GLUE Home signs its window in with a single-use code", "file_type": "rationale", "source_file": "vault/adr/0159-glue-homes-first-run-and-its-window-signed-in.md", "rationale": "GLUE Home asks for a code (POST /v1/auth/window-code, two minutes), puts it in window initialization (window.__glueHomeSignIn). The page trades it once for a session of GLUE Home's companion."}, {"id": "glue_folder_always_offered_mechanism", "label": "A GLUE folder is always offered on the start page", "file_type": "rationale", "source_file": "vault/adr/0159-glue-homes-first-run-and-its-window-signed-in.md", "rationale": "Folders can be chosen via GLUE Home's folder window (/fs/pick as glue). GLUE Home answering preselects 'This computer, with GLUE Home'. Without link: Look for GLUE Home again, or folder in browser."}], "edges": [{"source": "vault_adr_0159_glue_homes_first_run_and_its_window_signed_in_decision", "target": "first_run_guide_mechanism", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0159-glue-homes-first-run-and-its-window-signed-in.md"}, {"source": "vault_adr_0159_glue_homes_first_run_and_its_window_signed_in_decision", "target": "glue_folder_always_offered_mechanism", "relatio