{"nodes": [{"id": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "label": "ADR 0196: GLUE's playlists reach Engine DJ through a library of GLUE's own, shown as a drive", "file_type": "rationale", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ 5.3 merges each drive's library with its Collection every time it starts. One library of GLUE's, with songs by whole path, needs nothing on the user's drives; the rekordbox XML stays for rekordbox and as a way that needs no drive. Accepted 2026-11-26."}, {"id": "vault_adr_0196_engine_dj_drive_subst", "label": "GLUE's library shown as drive Z: (subst)", "file_type": "concept", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows subst, using the last free letter from Z:, made again each time GLUE Home starts. It lasts until the computer restarts, so an Engine DJ started before GLUE Home does not see the drive that time."}, {"id": "vault_adr_0196_aggregating_drives", "label": "Engine DJ 5.3 merges drives into the Collection at each start", "file_type": "concept", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tried with the user on 2026-11-26: made, changed, renamed, deleted and nested lists all arrived; Engine DJ knows a list by its name among its siblings, so a renamed list is a new one."}, {"id": "vault_adr_0196_alt_write_into_collection", "label": "Alternative: write into the Collection while Engine DJ is closed", "file_type": "rationale", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: it left Engine DJ unusable three times (ADR 0170 to 0182)."}, {"id": "vault_adr_0196_alt_xml_only", "label": "Alternative: the rekordbox XML only", "file_type": "rationale", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: it means a click and a drag each time the lists change."}, {"id": "vault_adr_0196_alt_drive_per_music_drive", "label": "Alternative: a GLUE library per music drive", "file_type": "rationale", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: two libraries on one drive, since Engine DJ makes one per drive. One library of GLUE's needs nothing on the user's drives."}, {"id": "vault_adr_0196_alt_other_libraries_songs_only", "label": "Alternative: point only at other libraries' songs", "file_type": "rationale", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: songs Engine DJ does not have yet could not go in."}, {"id": "vault_adr_0196_songs_by_whole_path", "label": "Songs: Engine DJ's own kept, others added by whole path", "file_type": "concept", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A song Engine DJ already has (the same file in the Collection or a drive's library here) is that one, keeping its analysis. Others go in by their whole path and Engine DJ analyses them. Songs not on this computer are left out and counted."}, {"id": "vault_adr_0196_windows_only", "label": "Windows only for now (no subst on macOS)", "file_type": "concept", "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "macOS has no subst; a disk image or a folder in /Volumes is still to be tried."}], "edges": [{"source": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "target": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "target": "vault_adr_0168_dj_apps_synced_both_ways_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "target": "vault_adr_0170_engine_dj_kept_in_step_both_ways_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0196-glues-own-engine-dj-library-on-a-drive-of-its-own.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "target": "vault_adr_0