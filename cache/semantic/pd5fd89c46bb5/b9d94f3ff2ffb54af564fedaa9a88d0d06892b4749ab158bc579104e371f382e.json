{"nodes": [{"id": "vault_features_discogs_feature", "label": "Discogs feature", "file_type": "document", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "discogs_token_connect", "label": "Discogs token connection", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A personal access token pasted in GLUE Home's settings, checked (Connected as ...) and kept on this computer, sent to Discogs' API only (ADR 0186)."}, {"id": "discogs_covers", "label": "Discogs as fourth cover service", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers for songs whose tags have none, after Deezer, iTunes and MusicBrainz; songs that found nothing before the token are looked up again once (ADR 0186)."}, {"id": "discogs_collection_view", "label": "Discogs collection view", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collection and wantlist in the sidebar Music section (#/discogs), with filter, search and sort; the records-as-library view of the user's Discogs (ADR 0187)."}, {"id": "discogs_in_glue_match", "label": "In GLUE status for records", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each record shows 'In GLUE: N of M tracks' or 'Not in GLUE'; the user's choices (Choose..., Not on it, Add) are remembered on the songs as discogs and discogsNo (ADR 0188)."}, {"id": "discogs_playlists", "label": "Discogs playlists", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playlists mix the user's songs and vinyl tracks (dg:<release>:<position> items); kept out of the library's Playlists, its pickers, Engine DJ and the exports (ADR 0189)."}, {"id": "discogs_auto_playlist", "label": "Auto Discogs playlist", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule-based (style, genre, artist, label, format, years, vinyl/digital/both, order), worked out live by discogsAuto; Save as a playlist freezes it. A record without a known tracklist counts as the whole record (0.79)."}, {"id": "discogs_reading", "label": "GLUE Home reads Discogs", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads lists 100 per page at one request every 1.1 s, after the token check, again after 20 hours and on Refresh; kept in profiles/<p>/discogs.json and read by the page through GLUE Home (discogs)."}, {"id": "discogs_tracklists", "label": "Record tracklists read once", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each record's tracklist is read once, after its covers, one request per record; missing ones are fetched at the next hourly look even when the list is fresh (0.79)."}, {"id": "discogs_matching", "label": "Discogs matching rules", "file_type": "rationale", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Track by track: title and version, artist, length within 8 s. Before the tracklist: the record's title as the songs' album, a compilation on its label, a single by its title. The user's choices come first."}, {"id": "discogs_not_yet", "label": "Discogs not yet", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not available on devices without GLUE Home; a matched record's cover is not yet given to its songs without a search."}, {"id": "discogs_tests", "label": "Discogs tests", "file_type": "document", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_features_discogs_feature", "target": "discogs_token_connect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_discogs_feature", "target": "discogs_covers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_discogs_feature", "target": "discogs_collection_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_discogs_feature", "target": "discogs_in_glue_match", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_discogs_feature", "target": "discogs_playlists", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_discogs_feature", "target": 