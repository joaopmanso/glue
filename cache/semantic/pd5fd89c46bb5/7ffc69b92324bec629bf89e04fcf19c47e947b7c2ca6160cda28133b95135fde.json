{"nodes": [{"id": "vault_features_glue_cloud_feature", "label": "GLUE Cloud: accounts, GLUE Home and devices", "file_type": "document", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional tier: sign in, pair GLUE Home on the main computer, see and play its library from other devices. Without an account GLUE works fully local (ADR 0036)."}, {"id": "vault_features_glue_cloud_pairing", "label": "Pairing GLUE Home by code or same account", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A signed-in website shows a single-use code valid 10 minutes; GLUE Home can also sign in with the same account. Works on a headless machine or NAS."}, {"id": "vault_features_glue_cloud_no_audio_on_server", "label": "No music or audio on GLUE Cloud", "file_type": "rationale", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio goes only between the user's own computers, DTLS-encrypted end to end; the signaling server cannot sit in the middle because each device's key signs its DTLS fingerprint (ADRs 0036, 0037)."}, {"id": "vault_features_glue_cloud_relay", "label": "TURN relay for streaming away from home", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct paths are tried first; relayed traffic is paid per GB beyond a free allowance, so a per-account quota is needed before opening GLUE Cloud to many users (ADR 0081)."}, {"id": "vault_features_glue_cloud_offline_snapshot", "label": "Offline devices keep their last library snapshot", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A device that is offline shows its last snapshot marked stale; playing and downloading need it online."}, {"id": "vault_features_glue_cloud_accounts_tiers_admin", "label": "Accounts, tiers and admin", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google or email and password sign-in; the password is stretched in the browser and only a salted hash is stored; free, paid and admin tiers; admin panel at #/admin (ADR 0041)."}, {"id": "vault_features_glue_cloud_glue_home_app", "label": "GLUE Home app: Tauri tray app", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tray icon, settings, start with the computer, received songs; it is the user's own program on the user's computer (ADRs 0044, 0045, 0038)."}, {"id": "vault_features_glue_cloud_incoming_upload", "label": "Upload into GLUE Home's incoming folder", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Files are written as .part then renamed, with a checksum and resume; in the first release GLUE Home writes only into the incoming folder so the tab stays the only JSON writer (ADR 0038)."}, {"id": "vault_features_glue_cloud_drag_dock", "label": "Drag dock: queue of songs dragged into DJ apps", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DJ apps refuse anything a web page drags, so GLUE Home's own always-on-top window holds the real files (ADRs 0054, 0055, 0056, 0061)."}, {"id": "vault_features_glue_cloud_sending_songs", "label": "Sending songs to another computer", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sent over a WebRTC data channel, direct or through the relay; this computer's own GLUE Home is never offered as a target (ADRs 0067, 0081)."}, {"id": "vault_features_glue_cloud_covers_from_home", "label": "Covers and analyses shared by GLUE Home", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Other devices ask GLUE Home for covers and waveforms, kept in their own cache, never in GLUE Cloud (ADRs 0046, 0071, 0072, 0082, 0085)."}, {"id": "src_lib_account_svelte", "label": "src/lib/account.svelte.ts", "file_type": "code", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cloud_src_signal", "label": "cloud/src/signal.ts", "file_type": "code", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cloud_src_api", "label": "cloud/src/api.ts", "file_type": "code", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cloud_src_admin", "label": "cloud/src/admin.ts", "file_type": "code", "source_file": "vault/features/glue-cloud.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_system_signaling_room", "target": "cloud_src_signal", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour