{"nodes": [{"id": "src_help_dj_libraries_article", "label": "DJ libraries (help article)", "file_type": "document", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_help_dj_libraries_main_dj_library", "label": "Main DJ library", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its beat grids and cues become every song's by default, after what GLUE sets itself; it is the library GLUE keeps in step both ways."}, {"id": "src_help_dj_libraries_glue_playlists_in_engine_dj", "label": "GLUE's playlists in Engine DJ", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home keeps an Engine DJ library of its own, shown to Engine DJ as a drive; Engine DJ takes it in each time it starts, so the lists appear in a GLUE folder with nothing to set up. GLUE Home writes only while Engine DJ is closed; GLUE never writes Engine DJ's own files. Windows only for now."}, {"id": "src_help_dj_libraries_rekordbox_file", "label": "The rekordbox file (GLUE.xml)", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same playlists with hot cues, saved loops and beat grids in a rekordbox XML file, read by rekordbox and by Engine DJ (which needs a manual Update Rekordbox Library). Needs no drive, so it also serves a Mac."}, {"id": "src_help_dj_libraries_engine_dj_paused", "label": "Kept in step both ways with Engine DJ (paused)", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paused since November 2026: after Engine DJ 5.3 rebuilt its library, GLUE took the rebuilt library for changes, removed playlists made in Engine DJ and added copies of its own. Until it returns, GLUE only reads Engine DJ."}, {"id": "src_help_dj_libraries_followed_live", "label": "Libraries followed live", "file_type": "concept", "source_file": "src/help/dj-libraries.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With GLUE Home running, a DJ library is read again within seconds of the DJ app changing it, even with no GLUE tab open; Refresh reads it now."}], "edges": [{"source": "src_help_dj_libraries_article", "target": "src_help_dj_libraries_main_dj_library", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/help/dj-libraries.md", "source_location": null, "weight": 1.0}, {"source": "src_help_dj_libraries_article", "target": "src_help_dj_libraries_glue_playlists_in_engine_dj", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/help/dj-libraries.md", "source_location": null, "weight": 1.0}, {"source": "src_help_dj_libraries_article", "target": "src_help_dj_libraries_rekordbox_file", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/help/dj-libraries.md", "source_location": null, "weight": 1.0}, {"source": "src_help_dj_libraries_article", "target": "src_help_dj_libraries_engine_dj_paused", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/help/dj-libraries.md", "source_location": null, "weight": 1.0}, {"source": "src_help_dj_libraries_article", "target": "src_help_dj_libraries_followed_live", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/help/dj-libraries.md", "source_lo