{"nodes": [{"id": "vault_system_glue_system", "label": "GLUE: how it works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null}, {"id": "glue_architecture_pieces", "label": "GLUE Architecture Pieces", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.1-1.4", "rationale": "Four main pieces compose GLUE: the website (client-side Svelte app), GLUE folder (JSON data store), GLUE Home (Rust-based engine), and GLUE Cloud (optional sync service)"}, {"id": "website_component", "label": "Website", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.1", "rationale": "Svelte 5 + TypeScript app on GitHub Pages, works offline without account"}, {"id": "glue_folder_component", "label": "GLUE folder", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.2", "rationale": "User's data as JSON files without database, chosen on first run or in OPFS"}, {"id": "glue_home_component", "label": "GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.3", "rationale": "Tauri 2 tray app on Windows/macOS; when running, it is the library engine and the website is its screen"}, {"id": "glue_cloud_component", "label": "GLUE Cloud", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.4", "rationale": "Optional account service: Cloudflare Worker with D1 and Durable Object; holds collections, profiles, devices"}, {"id": "glue_folder_storage", "label": "GLUE folder structure and storage", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "2", "rationale": "Organized as profiles, collections with tracks sharded by id, analysis summaries, playlists, DJ library sources, calendar, backups, and cloud sync state"}, {"id": "collection_store", "label": "CollectionStore", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "2"}, {"id": "track_entity", "label": "Track (song)", "