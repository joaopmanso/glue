{"nodes": [{"id": "vault_adr_0131_rows_on_screen_ask_until_answered_decision", "label": "ADR 0131: What rows on screen need from another computer is asked for until it's answered", "file_type": "rationale", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users were experiencing missing waveforms and covers on the first remote load. The decision unifies retry logic for rows on-screen data fetching (thumbnails, waveforms, covers) and ensures failed requests are retried until the row is visible on-screen or the data is received."}, {"id": "on_screen_helper_concept", "label": "OnScreen helper", "file_type": "code", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies row visibility counting for thumbnails, waveforms, and covers; tracks which rows are currently on screen"}, {"id": "retries_mechanism_concept", "label": "Retries mechanism", "file_type": "concept", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks again only while a row is on screen; exponential backoff (1, 2, 4... up to 15s for unknown; 8, 16... up to 60s for 'none there yet'); dropped when row scrolls away"}, {"id": "thumbnails_waveforms_covers_loader_concept", "label": "Thumbnails, waveforms, covers loader", "file_type": "concept", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Previously had drifting copies of on-screen and retry logic; thumbs.svelte.ts dropped songs it couldn't ask about; covers marked 'tried' before asking, failing silently"}, {"id": "remote_data_fetch_concept", "label": "Remote data fetch from another computer", "file_type": "concept", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers list each song with its data or null; missing songs from answer couldn't be reached; unknown songs stay unknown and are retried; null shows and is retried"}, {"id": "src_lib_on_screen_ts_code", "label": "src/lib/onScreen.ts", "file_type": "code", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_lib_thumbs_svelte_ts_code", "label": "src/lib/thumbs.svelte.ts", "file_type": "code", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 19", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_lib_covers_svelte_ts_code", "label": "src/lib/covers.svelte.ts", "file_type": "code", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 25", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_lib_remote_files_svelte_ts_code", "label": "src/lib/remoteFiles.svelte.ts", "file_type": "code", "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 23", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0131_rows_on_screen_ask_until_answered_decision", "target": "src_lib_on_screen_ts_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0131-rows-on-screen-ask-until-answered.md", "source_location": "line 30", "weight": 1.0}, {"source": "vault_adr_0131_rows_on_screen_ask_until_answered_decision", "target": "src_lib_thu