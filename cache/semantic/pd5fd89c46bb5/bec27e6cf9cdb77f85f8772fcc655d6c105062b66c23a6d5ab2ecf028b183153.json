{"nodes": [{"id": "github_workflows_home_workflow", "label": "GLUE Home build workflow (home.yml)", "file_type": "code", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds Windows and macOS on each push to main that touches GLUE Home or its engine crates; when the version in tauri.conf.json has no release yet, the same build is that version's release (ADR 0044, 0045)."}, {"id": "github_workflows_home_publish_job", "label": "Publish job: the release and the updater manifest", "file_type": "code", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_home_release_all_or_nothing", "label": "Release published only once every build passed", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A release is all or nothing: 0.64.0 and 0.68.0 were half published when the macOS build failed after the Windows one had uploaded."}, {"id": "github_workflows_home_one_build_per_change", "label": "One build per change: a push and its tag do not build twice", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On 2026-09-30 a push and then a tag built everything twice, about 6 minutes each."}, {"id": "github_workflows_home_connection_tests_timeout", "label": "Connection tests limited to 15 minutes", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The connection tests take about a minute; on 2026-10-20 the Edge probe hung for 20 minutes, while the job's own limit is 6 hours."}, {"id": "github_workflows_home_no_worker_check", "label": "No analysis worker in GLUE Home's pages", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home has no audio JavaScript: its engine is Rust, so its pages ship no analysis worker (ADR 0147)."}, {"id": "github_workflows_home_no_service_page_check", "label": "No hidden service page in GLUE Home", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home's service is its engine's, so there is no hidden service page (ADR 0160)."}, {"id": "github_workflows_home_rust_cache", "label": "Shared Rust build cache across the Rust workspaces", "file_type": "concept", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dependencies (about 400 crates) are compiled once, not on every run; only main's builds save and read the cache."}, {"id": "github_workflows_home_signed_updates", "label": "Update files signed with a secret key", "file_type": "concept", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home only installs updates signed with this key, so the build signs them from a GitHub secret."}, {"id": "github_workflows_home_latest_json_manifest", "label": "latest.json: the updater's manifest", "file_type": "concept", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "github_workflows_home_rust_tests_each_system", "label": "GLUE Home's Rust tests run on each system", "file_type": "rationale", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some rules differ by system: a ':' in a file name is fine on macOS (ADR 0134)."}, {"id": "github_workflows_home_crate_tests", "label": "Native crates' tests and clippy in CI", "file_type": "concept", "source_file": ".github/workflows/home.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The engine, store, DJ-library, library-engine and connection crates are held to the website's results (tests/golden) and to clippy with warnings denied (ADR 0147, 0152, 0167, 0153, 0150)."}], "edges": [{"source": "github_workflows_home_release_all_or_nothing", "target": "github_workflows_home_publish_job", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/home.yml", "source_location": null, "weight": 1.0}, {"source": "github_workflows_home_one_build_per_change", "target": "github_workflows_home_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/home.yml", "source_location": null, "weight": 1.0}, {"source": "github_workflows_home_connection_tests_timeout", "target": "github_workflows_home_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/home.yml", "source_location": null, "weight": 1.0}, {"source": "github_workflows_home_no_worker_check", "target": "github_workflows_home_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/workflows/home.yml", "source_location": null, "weight": 1.0}, {"source": "github_workflows_home_no_service_page_check", "target": "github_workflows_home_workflow", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour