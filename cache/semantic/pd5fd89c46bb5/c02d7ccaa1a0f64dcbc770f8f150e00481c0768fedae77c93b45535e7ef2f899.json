{"nodes": [{"id": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "label": "ADR 0186: Discogs covers, with the user's token", "file_type": "rationale", "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The token is kept in GLUE Home's settings, not the GLUE folder, because the folder spreads to every device and backup and a token is a credential. Sign in with Discogs (OAuth) was rejected: it needs a registered app and a secret kept safe. Discogs comes fourth because the other services answer faster without an account; it fills the gaps they leave (vinyl, white labels). Supersedes ADR 0086's line on Discogs."}, {"id": "vault_adr_0186_discogs_token_only_to_discogs", "label": "The Discogs token goes to Discogs' API only", "file_type": "rationale", "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An Authorization header goes to api.discogs.com only: not to Discogs' image host and not after a redirect elsewhere. The token never leaves for another host."}, {"id": "vault_adr_0186_discogs_requests_paced", "label": "Discogs requests paced 1.1 s apart", "file_type": "concept", "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "60 requests a minute with a token; the pace is shared by all of GLUE Home's Discogs requests."}], "edges": [{"source": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "target": "vault_adr_0086_covers_looked_up_by_glue_home_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "target": "vault_adr_0187_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "target": "vault_research_discogs_api_findings", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0186_discogs_token_only_to_discogs", "target": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0186_discogs_requests_paced", "target": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "hyper_discogs_cover_lookup_flow", "label": "Discogs cover look-up with the user's token", "nodes": ["vault_adr_0186_discogs_covers_with_the_users_token_decision", "vault_adr_0186_discogs_token_only_to_discogs", "vault_system_glue_home_discogs_covers", "src_help_glue_home_covers_from_discogs", "vault_features_song_info_covers_looked_up"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0186-discogs-covers-with-the-users-token.md"}]}