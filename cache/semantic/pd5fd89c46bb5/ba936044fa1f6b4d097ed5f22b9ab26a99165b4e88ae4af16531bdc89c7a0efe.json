{"nodes": [{"id": "vault_adr_0147_glue_home_analyses_natively_decision", "label": "ADR 0147: GLUE Home analyses natively in Rust", "file_type": "rationale", "source_file": "vault/adr/0147-glue-home-analyses-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move GLUE Home's audio processing from JavaScript to native Rust for efficiency and to support formats like ALAC and DSD. Creates crates/glue-audio: line-for-line port of TypeScript analysis with JavaScript-compatible numbers. Solves 342 ALAC and 91 DSF format failures. Held to TypeScript results by golden tests."}, {"id": "golden_tests_mechanism", "label": "Golden Tests", "file_type": "rationale", "source_file": "vault/adr/0147-glue-home-analyses-natively.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mechanism to hold Rust implementation to TypeScript results. TypeScript pipeline writes results to tests/golden/<case>/. Rust crate reads and compares byte-for-byte or within rounding tolerance (1e-12 for info/summary, 1e-9 for verdict, 1e-6 for spectrum). Ensures parity between implementations."}], "edges": [{"source": "vault_adr_0147_glue_home_analyses_natively_decision", "target": "crates_glue_audio_code", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0147-glue-home-analyses-natively.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0147_glue_home_analyses_natively_decision", "target": "golden_tests_mechanism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0147-glue-home-analyses-natively.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0147_glue_home_analyses_natively_decision", "target": "vault_adr_0148_glue_home_analyses_songs_in_rust_decision", "relation": "rationale_for", "confidence": "EXTRA