{"nodes": [{"id": "vault_research_engine_dj_write_back_document", "label": "Engine DJ: what writing back to it involves", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Findings from read-only copies of the user's Engine DJ databases and libdjinterop's source. Marks what is unverified. Concludes playlist writes need an experiment with Engine DJ before GLUE writes them; cue, loop and grid blobs are the lower-risk part."}, {"id": "engine_dj_playlist_tree_copies", "label": "Playlist tree copied into every Engine DJ database", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same 763 playlists are in each of the user's three databases; Engine DJ copies the tree into every database. How it reconciles them is UNVERIFIED; the counts suggest each list is reconciled to its latest edit, and the Collection shows the computer's database's tree."}, {"id": "engine_dj_membership_reference", "label": "membershipReference", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Its meaning is UNVERIFIED. In F: most of a drive's own songs have 0, some 1; in C: values 0 to 5."}, {"id": "engine_dj_drive_copy_match_hypothesis", "label": "Drive copy must match the Collection (hypothesis)", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNVERIFIED hypothesis: Engine DJ expects a drive's copy of shared lists to match the Collection; drift caused by GLUE's writes may leave a new list locked. The 2026-10-13 test on 2022 was meant to check it."}, {"id": "engine_dj_performance_blobs", "label": "Engine DJ cue, loop and beat-grid blobs", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cues, loops and the beat grid are stored as blobs in PerformanceData, encoded as libdjinterop does. Read-modify-write per song with Engine DJ closed, keeping unknown bytes; the lower-risk part of writing back, compared with playlists."}], "edges": [{"source": "vault_research_engine_dj_write_back_document", "target": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "engine_dj_playlist_tree_copies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "engine_dj_membership_reference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "engine_dj_drive_copy_match_hypothesis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "engine_dj_performance_blobs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "engine_dj_drive_copy_match_hypothesis", "target": "engine_dj_playlist_tree_copies", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "engine_dj_drive_copy_match_hypothesis", "target": "engine_dj_folder_lock_after_repair", "relation": "rationale_for", "confidence": "AMBIGUOUS", "confidence_score": 0.2, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}], "hyperedges": []}