{"nodes": [{"id": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "label": "ADR 0195: GLUE's playlists reach Engine DJ as a rekordbox XML that GLUE Home keeps", "file_type": "rationale", "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ 5.3 merged every drive's library into the Collection and copied its playlists into each drive, assuming ids line up; GLUE's own writes broke the user's Collection three times, so ADR 0194 turned them off. Engine DJ reads other apps' libraries from a rekordbox XML without touching its databases, and only GLUE Home can write that file (it knows each song's absolute path). Alternatives rejected: a GLUE library Engine DJ sees as a drive (5.3 merges drives), writing the Collection more carefully (three breakages), the website writing the XML into the GLUE folder (wrong absolute paths), a Traktor NML (Traktor's own place, unverified)."}, {"id": "vault_system_engine_dj_5_3_incident", "label": "Engine DJ 5.3 Collection merge that broke GLUE's playlists", "file_type": "concept", "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ 5.3 merges every drive's library into the Collection on start and copies the Collection's new playlists into every drive's database, assuming playlist ids line up. GLUE's folder kept in the Collection only made them differ; Engine's copy of a new playlist became its own parent on F: and its merge never finished. Repaired by hand."}], "edges": [{"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0184_engine_dj_folder_repair_turned_off_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_playlists_reach_engine_dj_as_a_rekordbox_xml_decision", "target": "vault_adr_0167_dj_libraries_in_glue_home_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0195-glues-playlists-reach-engine-dj-as-a-rekordbox-xml.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0195_glues_pl