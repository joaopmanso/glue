{"nodes": [{"id": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "label": "ADR 0181: An Engine DJ library found in the Music folder; one made where a song's drive has none, once it's known safe", "file_type": "rationale", "source_file": "vault/adr/0181-engine-dj-libraries-made-where-a-drive-has-none.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ keeps the start disk's library in the Music folder, not at the drive's top, so a song on C: was refused. Libraries are looked for there too, and made on a drive with none only once it is known that Engine DJ uses a database GLUE made on a drive; held until then. The use of such a database is UNVERIFIED."}], "edges": [{"source": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "target": "vault_adr_0171_engine_dj_playlists_kept_in_step_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0181-engine-dj-libraries-made-where-a-drive-has-none.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "target": "vault_adr_0179_engine_dj_edited_in_the_dj_collection_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0181-engine-dj-libraries-made-where-a-drive-has-none.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0181_engine_dj_libraries_made_where_a_drive_has_none_decision", "target": "vault_adr_0180_glues_playlists_in_engine_djs_glue_folder_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0181-engine-dj-libraries-made-where-a-drive-has-none.md", "source_location": null, "weight": 1.0}], "hyperedges": []}