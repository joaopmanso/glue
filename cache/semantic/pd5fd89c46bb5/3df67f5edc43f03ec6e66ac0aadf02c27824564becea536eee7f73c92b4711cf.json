{"nodes": [{"id": "vault_features_library_scanner_feature", "label": "Feature: Library & scanner", "file_type": "document", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds music collection from folders and files with scanning, tagging, analysis, matching imported libraries, and relinking missing files"}, {"id": "relinking_mechanism", "label": "Relinking: match and link unlinked songs", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imported songs without files are matched to library songs by title, artist, length, filename, and album; matches shown with confidence; links can be made individually or in bulk above a certainty threshold (ADR 0124)"}, {"id": "quick_hash_mechanism", "label": "Quick hash: SHA-1 for file rename detection", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SHA-1 hash of file size plus first and last 64 KB detects renamed files during rescan without marking as delete plus add"}, {"id": "file_system_observer_mechanism", "label": "FileSystemObserver: live file updates", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrome 133+ uses FileSystemObserver API for live detection of added, changed, and removed files instead of manual rescan on open"}, {"id": "absolute_path_strategy_decision", "label": "Absolute path: per-root handling", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each folder root stores absolute path once when added, or path is inferred later from imports (ADR 0012)"}, {"id": "imported_record_matching_mechanism", "label": "Imported record matching: fold into library tracks", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Records without files are matched on each library read and collection open; a successful match folds the imported record into the track with the file (ADR 0066)"}, {"id": "waveform_thumbnails_mechanism", "label": "Waveform thumbnails: mini spectrograms per track", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overview column shows level of lows, mids, and highs from analysis spectrogram (768 bytes per song); drawn at analysis time or once from stored analysis; displayed as clickable/draggable waveform (ADR 0031)"}, {"id": "folder_removal_mechanism", "label": "Folder removal: impact tracking and backup", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing a folder removes its songs and orphaned unlinked songs; removalImpact describes impact; pre-orphan backup created; users can restore or remove orphans after backup (ADR 0111)"}, {"id": "offline_folder_handling", "label": "Offline folder handling: missing folders preserve songs", "file_type": "rationale", "source_file": "vault/features/library-scanner.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Folders unreachable due to network or unplugged drive keep their songs; rescan finding them empty does not mark 