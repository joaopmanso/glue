{"nodes": [{"id": "vault_research_engine_dj_write_back_document", "label": "Engine DJ: what writing back to it involves", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Research for the two-way sync of playlists, cues, loops and beat grid between GLUE and Engine DJ; read from copies of the user's databases, nothing written."}, {"id": "vault_research_engine_dj_write_back_databases", "label": "Engine DJ databases (one m.db per place)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each place Engine DJ uses (computer, each drive) has its own Engine Library/Database2/m.db with its own Information.uuid; schema 3.0.2."}, {"id": "vault_research_engine_dj_write_back_playlist_tree", "label": "Playlist tree copied into every Engine DJ database", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The playlist tree is the same in every database; how Engine DJ reconciles them (which wins, what an unplugged drive gets later) is unverified and must be watched in Engine DJ itself."}, {"id": "vault_research_engine_dj_write_back_playlist_id_clash", "label": "Playlist id clash at 9047 between C: and F:", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE's writes into F: alone advanced F:'s id sequence past C:'s, so the same id named different playlists in the two databases."}, {"id": "vault_research_engine_dj_write_back_stuck_new_playlists", "label": "Engine DJ's new playlists stuck (rename only)", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hypothesis, unverified: Engine DJ keeps a drive's copy in step with the Collection, and lists drifted apart through GLUE's F:-only writes, so a change it cannot make in the drive's copy leaves the new list locked."}, {"id": "vault_research_engine_dj_write_back_cues_loops_grid", "label": "Cues, loops and beat grid in PerformanceData blobs", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One PerformanceData row per song holds quickCues (zlib, big-endian), loops (little-endian, uncompressed) and beatData blobs; positions are samples; writing changes Track.lastEditTime by trigger. Matches libdjinterop's encoders."}, {"id": "vault_research_engine_dj_write_back_aggregating_drives", "label": "Engine DJ 5.3 Aggregating drives job", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ 5.3 merges each connected drive's library into the Collection on every start, in one long write transaction that locks edits; it renumbers a drive's entries with a trackId shift."}, {"id": "vault_research_engine_dj_write_back_parent_id_loop", "label": "Engine 5.3 parent-id loop bug", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine copies new Collection playlists into drives with new ids but keeps the Collection's parentListId; when ids differ between databases a parent loop forms, recursive views never end, and the merge grew to 13 GB. Engine's bug, triggered by playlists that differ across databases."}, {"id": "vault_research_engine_dj_write_back_glue_writes_paused", "label": "GLUE playlist writes paused and made as Engine DJ makes them", "file_type": "decision", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE's playlist writes were paused (0.72.3) and resumed only as Engine DJ makes them: into C:'s database (the master) and every other database carrying the tree, with the same id, and the DJ collection read from C:'s tree."}, {"id": "vault_research_engine_dj_write_back_glue_own_library", "label": "GLUE's own library separate from Engine DJ's Collection", "file_type": "decision", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never add playlists to Engine DJ's Collection that the drives do not get too, since differing playlist ids set off the 5.3 parent-id bug; GLUE's own library should be a separate one, as a drive's is, and Engine's logs are checked after any write."}, {"id": "vault_research_engine_dj_write_back_engine_rules", "label": "Engine DJ rules for third-party tools", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Do not open the database while Engine DJ runs; never change the schema; identify songs by (originDatabaseUuid, originTrackId). Source: Engine KB article."}, {"id": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "label": "ADR 0173", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "label": "ADR 0182", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "label": "ADR 0194", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_research_engine_dj_write_back_document", "target": "vault_research_engine_dj_write_back_databases", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "vault_research_engine_dj_write_back_playlist_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "vault_research_engine_dj_write_back_cues_loops_grid", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_document", "target": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_playlist_tree", "target": "vault_research_engine_dj_write_back_playlist_id_clash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vau