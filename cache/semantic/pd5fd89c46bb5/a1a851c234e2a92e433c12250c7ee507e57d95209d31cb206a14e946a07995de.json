ch_engine_dj_write_back_glue_own_library", "target": "vault_research_engine_dj_write_back_parent_id_loop", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_glue_own_library", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_stuck_new_playlists", "target": "vault_research_engine_dj_write_back_playlist_id_clash", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "vault_research_engine_dj_write_back_flow_engine_5_3_incident", "label": "Engine DJ 5.3 drive-merge incident", "nodes": ["vault_research_engine_dj_write_back_aggregating_drives", "vault_research_engine_dj_write_back_parent_id_loop", "vault_research_engine_dj_write_back_playlist_tree"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md"}]}