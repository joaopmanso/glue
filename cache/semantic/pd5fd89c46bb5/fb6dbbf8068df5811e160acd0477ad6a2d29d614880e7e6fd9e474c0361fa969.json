{"nodes": [{"id": "vault_adr_0135_analysis_around_network_folders_and_tags_by_glue_home_decision", "label": "ADR 0135: Analysis around network folders: songs take turns, GLUE Home reads tags in batches", "file_type": "rationale", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Network folder analysis bottlenecked by NAS bandwidth (12-24 MB/s), not processor. Three coordinated solutions: unified 'left' count between tab and GLUE Home, limit concurrent network folder songs to 4 per folder, read tags in efficient batches via /fs/read-tags endpoint (8 files at a time, 500 paths per request)."}, {"id": "unified_progress_count_concept", "label": "One 'left' count (queued + running)", "file_type": "concept", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both GLUE Home window and browser tab show same count. Tab shows GLUE Home's 'left' while it has work; when zero, shows browser's unread results. Resolved discrepancy where browser showed queued+running while GLUE Home showed them separately."}, {"id": "network_folder_song_queuing_mechanism", "label": "Network folder songs take turns (max 4 per folder)", "file_type": "rationale", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Song from network folder (\\\\server\\share or //server/share) starts only while fewer than 4 from that folder are running. Other slots filled by processor-limited local drive songs. Prevents NAS bandwidth limit from blocking all processing."}, {"id": "tag_batch_reading_mechanism", "label": "GLUE Home /fs/read-tags batch reading", "file_type": "rationale", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoint reads tags only (no audio/pictures) from up to 500 paths, 8 files at a time. In Home mode, scan requests 200 songs per batch, count updates per request. Fallback: single-file reading without GLUE Home or older versions. Much faster than reading file headers sequentially."}, {"id": "home_ui_lanes_ts_code", "label": "home/ui/lanes.ts", "file_type": "code", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_home_analysis_component", "label": "GLUE Home analysis (fillInfo)", "file_type": "concept", "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0135_analysis_around_network_folders_and_tags_by_glue_home_decision", "target": "unified_progress_count_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0135_analysis_around_network_folders_and_tags_by_glue_home_decision", "target": "network_folder_song_queuing_mechanism", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0135_analysis_around_network_folders_and_tags_by_glue_home_decision", "target": "tag_batch_reading_mechanism", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "network_folder_song_queuing_mechanism", "target": "home_ui_lanes_ts_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "tag_batch_reading_mechanism", "target": "glue_home_analysis_component", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "network_analysis_optimization_flow", "label": "Network folder analysis optimization", "nodes": ["unified_progress_count_concept", "network_folder_song_queuing_mechanism", "tag_batch_reading_mechanism"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "vault/adr/0135-analysis-around-network-folders-and-tags-by-glue-home.md"}]}