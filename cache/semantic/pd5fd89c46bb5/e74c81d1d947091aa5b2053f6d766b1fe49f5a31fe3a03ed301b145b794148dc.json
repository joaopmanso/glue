{"nodes": [{"id": "vault_adr_0132_connections_to_glue_home_are_bounded_decision", "label": "ADR 0132: Connections to GLUE Home are bounded", "file_type": "rationale", "source_file": "vault/adr/0132-connections-to-glue-home-are-bounded.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home had unbounded RTCPeerConnection creation leading to browser limits (500 max), causing connection failures when rows on screen retry every 1-15s. Decision: GLUE Home limits connections to 20 being set up at once, lets idle ones go after 30s, website backs off reconnect attempts to 5-60s for background tasks."}, {"id": "rtcpeerconnection_concept", "label": "RTCPeerConnection", "file_type": "concept", "source_file": "vault/adr/0132-connections-to-glue-home-are-bounded.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0132_connections_to_glue_home_are_bounded_decision", "target": "vault_adr_0131_rows_on_screen_ask_until_answered_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0132-connections-to-glue-home-are-bounded.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0132_connections_to_glue_home_are_bounded_decision", "target": "rtcpeerconnection_concept", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0132-connections-to-glue-home-are-bounded.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0132_connections_to_glue_home_are_bounded_decision", "target": "glue_home_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0132-connections-to-glue-home-are-bounded.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "glue_home_streaming_flow", "label": "Streaming songs to other devices