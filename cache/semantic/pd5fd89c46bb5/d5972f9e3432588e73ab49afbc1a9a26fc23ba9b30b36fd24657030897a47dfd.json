{"nodes": [{"id": "vault_adr_0193_downloads_decision", "label": "ADR 0193: Download songs as files: ranges from GLUE Home, a zip written as it goes", "file_type": "rationale", "source_file": "vault/adr/0193-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set can be many gigabytes on a remote connection that may drop. remoteFiles.get holds a whole song in memory and core/zip.ts builds a zip in memory with no ZIP64, so neither fits. Decision: a streaming stored zip (header first, CRC patched, ZIP64 only past 4 GB), 4 MB ranges that resume on failure, a save dialog where the browser has one, and missing songs listed rather than passing silently. No server sees the music (ADR 0002, 0037)."}, {"id": "concept_numbered_playlist_folder", "label": "A playlist downloads as a numbered folder", "file_type": "rationale", "source_file": "vault/adr/0193-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set's order is the point and a player lists a folder by name, so songs are numbered (01 ..., 02 ...). An M3U playlist was rejected because DJ gear browsing a USB drive lists files, and numbered names work everywhere. A selection keeps its own names."}, {"id": "concept_missing_songs_listed", "label": "Missing songs are listed, never skipped silently", "file_type": "rationale", "source_file": "vault/adr/0193-downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A song that cannot be fetched, or has no file linked, is left out and listed in the panel so it can be checked before a gig; the rest still come. A disk error stops the whole download."}], "edges": [{"source": "vault_adr_0193_downloads_decision", "target": "vault_adr_0002_static_client_only_app_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "vault_adr_0037_p2p_webrtc_transport_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "src_core_zipstream", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "src_lib_remotefiles_svelte", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "src_lib_downloads_svelte", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "src_core_library_downloadplan", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0193_downloads_decision", "target": "src_core_zip", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "concept_numbered_playlist_folder", "target": "src_core_library_downloadplan", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}, {"source": "concept_missing_songs_listed", "target": "src_ui_library_downloadpanel_svelte", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0193-downloads.md", "source_location": null, "weight": 1.0}], "hyperedges": []}