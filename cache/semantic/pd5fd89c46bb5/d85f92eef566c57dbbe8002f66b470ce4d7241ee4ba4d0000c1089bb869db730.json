{"nodes": [{"id": "vault_system_md_document", "label": "GLUE: how it works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complete architectural overview: the Website (Svelte+TypeScript), GLUE folder (JSON store), GLUE Home (Rust Tauri app), and GLUE Cloud, with all their interactions and data flows"}, {"id": "glue_folder_json_store_component", "label": "GLUE folder: JSON files store", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User's data directory with JSON files for profiles, collections, tracks, analysis, playlists, sources, events, duplicates, backups, and cloud sync state; no database; keys use mco prefix for backward compatibility"}, {"id": "glue_cloud_cloudflare_worker_component", "label": "GLUE Cloud: Cloudflare Worker with D1 and Durable Object", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional account service holding collections (never music), profiles, devices, and signaling; provides presence tracking, broadcasts to devices, TURN relay credentials, and admin panel"}, {"id": "native_analysis_engine_rust_component", "label": "Native analysis engine: glue-audio in Rust", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Line-for-line Rust port of TypeScript analysis; runs in GLUE Home on all formats including DSD conversion; produces verdict, BPM, key, bandwidth, bit depth, fingerprint, spectrogram, waveform"}, {"id": "glue_home_rust_engine_crate_component", "label": "glue-engine crate: GLUE Home's Rust engine", "file_type": "code", "sourc