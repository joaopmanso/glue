{"nodes": [{"id": "src_help_sets_article", "label": "Help: Mixing a set", "file_type": "document", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_help_sets_drop_finding", "label": "Drop found where the bassline comes in", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A kick alone falls away between the beats and a bassline holds the lows up, so the drop is read where the bass comes in (from the waveform, or from loudness when there is none)."}, {"id": "src_help_sets_styles", "label": "Set styles: one at a time, continuous, double drops", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Songs whose tempos are more than 8 % apart are cut on the phrase instead of blended."}, {"id": "src_help_sets_three_decks_layering", "label": "Layering alike songs on 3 decks", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two songs in a row that sound alike (close tempos, keys that fit) are layered: the second comes in early and plays along for 48 bars; only one has its bass at a time."}, {"id": "src_help_sets_timeline_follow_playhead", "label": "Timeline follows the playhead", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While it plays the timeline follows the playhead; zooming, scrolling or dragging stops the following, and the crosshair by Play turns it on again."}, {"id": "src_help_sets_song_round_menu", "label": "Song's round menu", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Click a song to select it and open its menu where clicked: Play on top, Mix in left, Mix out right, Key lock below, Page upper left, Bass upper right, level in the middle."}, {"id": "src_help_sets_hand_over_box", "label": "Hand-over box", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each hand-over's chip opens its box: style, whose bass plays, length, next song earlier or later, how alike, and Hear it."}, {"id": "src_help_sets_bass_strip", "label": "Bass strip: cutting a song's bass by hand", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A strip along the foot of a hovered song: drag along it to cut the bass over those bars or open it where cut (hatched red cut, orange opened, each with a x)."}, {"id": "src_help_sets_glue_home_mixes_the_set", "label": "GLUE Home mixes the set (0.84 or later)", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With GLUE Home running, it reads the songs from disk, mixes them and streams the mix to the page; if a song is not on that computer the page mixes in the browser instead."}, {"id": "src_help_sets_export", "label": "Export the mix, a part, or the tracklist", "file_type": "concept", "source_file": "src/help/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "src_help_sets_article", "target": "src_core_guide_tours_tour_playlists", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "src/hel