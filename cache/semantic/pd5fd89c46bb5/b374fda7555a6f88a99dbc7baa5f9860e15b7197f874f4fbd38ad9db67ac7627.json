{"nodes": [{"id": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "label": "ADR 0207: Trim the song's menu to fixed, labelled places; follow the playhead only until the user looks elsewhere", "file_type": "document", "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user said ADR 0206's menu sometimes did not show, took seconds, or disappeared, was cluttered and not intuitive; the hand-over box's Cut button sat outside its frame; and the view pulled back after every zoom or scroll while playing. Supersedes ADR 0206's list of the menu's items and how it opens."}, {"id": "vault_adr_0207_fixed_labelled_menu_places", "label": "Menu items in fixed, labelled places", "file_type": "rationale", "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Items spread evenly round a ring move as items come and go, so nothing is learned; each item keeps a fixed place with a label. Earlier and later leave the menu (they are the song's own drag)."}, {"id": "vault_adr_0207_bass_strip_click_opens_menu", "label": "A click on the bass strip opens the song's menu", "file_type": "rationale", "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bass strip was 12 px, 34 px under the pointer (about 40 % of a song's height) and caught clicks, selecting without opening the menu. It grows to 22 px; a click that is not a drag opens the menu, only a drag edits the bass."}, {"id": "vault_adr_0207_follow_playhead_until_user_looks", "label": "Follow the playhead until the user looks elsewhere", "file_type": "rationale", "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user asked that follow stay off once they zoom, scroll or drag, until turned on again. A follow that only pauses for a few seconds was rejected for that reason. The follow is bound between SetView and SetLanes; with follow off, the playhead can run out of view."}, {"id": "vault_adr_0207_press_grab_450ms", "label": "A press is a grab after 450 ms", "file_type": "rationale", "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A press held 350 ms counted as a grab, so a slow click opened the menu only when let go; the threshold is now 450 ms, and a cancelled pointer lets go of a drag."}], "edges": [{"source": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "target": "vault_adr_0206_a_sets_page_one_menu_a_pinned_timeline_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "target": "vault_adr_0207_fixed_labelled_menu_places", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "target": "vault_adr_0207_bass_strip_click_opens_menu", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "target": "vault_adr_0207_follow_playhead_until_user_looks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_a_set_menu_trimmed_and_follow_mode_decision", "target": "vault_adr_0207_press_grab_450ms", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_fixed_labelled_menu_places", "target": "src_help_sets_song_round_menu", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_bass_strip_click_opens_menu", "target": "src_help_sets_bass_strip", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_follow_playhead_until_user_looks", "target": "src_help_sets_timeline_follow_playhead", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_press_grab_450ms", "target": "src_help_sets_article", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_follow_playhead_until_user_looks", "target": "src_ui_sets_setview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0207_follow_playhead_until_user_looks", "target": "src_ui_sets_setlanes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "vault_adr_0207_song_menu_opened_and_placed", "label": "The song's menu: fixed places, opened by a click on the song or its bass strip", "nodes": ["vault_adr_0207_fixed_labelled_menu_places", "vault_adr_0207_bass_strip_click_opens_menu", "vault_adr_0207_press_grab_450ms", "src_help_sets_song_round_menu", "src_help_sets_bass_strip"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md"}, {"id": "vault_adr_0207_playhead_follow_flow", "label": "Following the playhead, off once the user looks elsewhere, on again by Play's crosshair", "nodes": ["vault_adr_0207_follow_playhead_until_user_looks", "src_help_sets_timeline_follow_playhead", "vault_features_sets_feature"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "vault/adr/0207-a-set-menu-trimmed-and-follow-mode.md"}]}