{"nodes": [{"id": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "label": "ADR 0187: The Discogs collection and wantlist: read by GLUE Home, kept in the profile, matched to the songs on the page, shown as a view", "file_type": "rationale", "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discogs lists releases, not songs, and most of a DJ's records may have no digital copy in GLUE, so the useful question is which records they also have here. Read only: nothing is written to Discogs. GLUE Home reads it because the token is kept there (ADR 0186); the page matches it because the page has the songs and redraws as they change."}, {"id": "vault_adr_0187_discogs_collection_read_by_glue_home_profile_file", "label": "profiles/<p>/discogs.json: the Discogs account kept per profile", "file_type": "rationale", "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a Source like a DJ library (records are not songs, and following, syncing and No file linked would misfire), and not a collection file: the same account belongs to every collection of the profile, so it would be copied into each and synced with the shared ones. Reading in the browser was rejected because the token would have to be on every device. The profile file is not synced through GLUE Cloud, so another computer sees it only with the same GLUE folder."}, {"id": "vault_adr_0187_discogs_collection_read_by_glue_home_matching", "label": "Matching on the page (discogsMatch.ts) to the open collection's songs", "file_type": "rationale", "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matching happens on the page, not in GLUE Home: the page has the songs and redraws as they change, and the matching is cheap (a few thousand records against an index of the songs). Records that do not match by album are not looked into, since there are no tracklists."}, {"id": "vault_adr_0187_discogs_collection_read_by_glue_home_view", "label": "The Discogs view (#/discogs): tabs, filters, sort, right-click menu", "file_type": "concept", "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0187_discogs_collection_read_by_glue_home_read_only", "label": "Discogs is read only; covers count against the pace too", "file_type": "rationale", "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing is written to Discogs. Covers share the Discogs request pace, so a first read of a large collection takes some minutes (about a second a cover); the list shows first."}], "edges": [{"source": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "target": "vault_adr_0051_glue_home_as_local_engine_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "target": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "target": "crates_glue_engine_src_discogs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "target": "src_core_library_discogsmatch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_profile_file", "target": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_matching", "target": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_view", "target": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0187_discogs_collection_read_by_glue_home_read_only", "target": "vault_adr_0187_discogs_collection_read_by_glue_home_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "h_discogs_collection_flow", "label": "Discogs collection flow: read by GLUE Home, kept per profile, matched on the page, shown as a view", "nodes": ["vault_adr_0187_discogs_collection_read_by_glue_home_decision", "vault_adr_0187_discogs_collection_read_by_glue_home_profile_file", "vault_adr_0187_discogs_collection_read_by_glue_home_matching", "vault_adr_0187_discogs_collection_read_by_glue_home_view"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0187-discogs-collection-read-by-glue-home.md"}]}