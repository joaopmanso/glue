{"nodes": [{"id": "vault_research_engine_dj_write_back_research", "label": "Engine DJ: what writing back to it involves", "file_type": "document", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-way sync with Engine DJ (playlists, cues, loops, beat grid). Read from copies of the user's Engine DJ databases with nothing written, plus libdjinterop's source. UNVERIFIED marks claims not yet confirmed."}, {"id": "vault_research_engine_dj_write_back_shared_playlist_tree", "label": "Playlist tree copied into every Engine DJ database", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ copies the playlist tree into every database it uses. How it reconciles them (which wins, what an unplugged drive gets later) is UNVERIFIED and must be watched in Engine DJ itself."}, {"id": "vault_research_engine_dj_write_back_collection_tree_master", "label": "Collection (computer database) tree as master", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inferred, UNVERIFIED: Engine DJ shows the computer's database tree as master and makes each change in every database carrying the tree, with the same id. Confirmed in part by the Collection vs drive song counts for 2022."}, {"id": "vault_research_engine_dj_write_back_id_clash_9047", "label": "Playlist id 9047 clash between C: and F:", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F: ids ran on from GLUE's writes, so the same id meant different playlists in two databases."}, {"id": "vault_research_engine_dj_write_back_f_only_glue_writes", "label": "GLUE playlist writes into one drive only (0.68 to 0.72)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Writing GLUE's playlists into F: only left them missing from the Collection and made the databases drift apart. Led to pausing the writes (0.72.3) and redoing them as Engine DJ makes them."}, {"id": "vault_research_engine_dj_write_back_engine_5_3_aggregating_drives", "label": "Engine DJ 5.3 Aggregating drives job", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On every start, Engine DJ 5.3 merges each connected drive's library into the Collection in one long write transaction. While it runs the Collection shows no songs and edits fail on a lock. It renumbers drive entries and copies new playlists with the Collection's parent ids."}, {"id": "vault_research_engine_dj_write_back_parent_id_loop", "label": "Parent-id loop that grew the merge to 13 GB", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The merge keeps the Collection's parentListId when it copies a new playlist into a drive with a new id. Ids only line up while every database has the same playlists, so a playlist became its own parent and the recursive views never ended."}, {"id": "vault_research_engine_dj_write_back_library_shown_as_drive", "label": "GLUE library shown as a drive (subst Z:)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A library of GLUE's own made the way a drive's is, shown in a folder as drive Z:. Engine DJ took it in as a drive; changes while closed were kept. This is the basis of ADR 0196: GLUE Home keeps this library and writes only its GLUE folder while Engine DJ is closed."}, {"id": "vault_research_engine_dj_write_back_locked_new_playlists", "label": "Engine DJ's own new playlists locked after drive drift", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hypothesis, UNVERIFIED: Engine DJ keeps a drive's copy in step with the Collection. A change it cannot make in the drive's copy leaves the new list locked (only renamable). The drift came from GLUE's F:-only writes, the restore into F:, and the 0.73.1 catch-up into C:."}, {"id": "vault_research_engine_dj_write_back_performance_data", "label": "PerformanceData row: cues, loops and grid per song", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per song in the database that holds the song. Its blobs (quickCues, loops, beatData, trackData) are written read-modify-write with unknown bytes kept, and only with Engine DJ closed. The lower-risk part of the write-back."}, {"id": "vault_research_engine_dj_write_back_quick_cues_blob", "label": "quickCues blob format", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compressed, big-endian: int64 count, then per hot cue a label and a double sample offset with colour, then the main cue values and extra bytes kept as they are."}, {"id": "vault_research_engine_dj_write_back_loops_blob", "label": "loops blob format", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not compressed and little-endian, unlike quickCues: int64 count, then per loop a label, start and end sample positions (-1 unset), set flags and colour."}, {"id": "vault_research_engine_dj_write_back_beat_data_blob", "label": "beatData blob format (grid markers)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compressed: sample rate and sample count, a grid-set flag, then the default and adjusted grids as lists of beat markers, with extra bytes kept."}, {"id": "vault_research_engine_dj_write_back_pen_drive_cue_loss", "label": "Cues missing after a pen drive sync (2026-11-27)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F: lacked cues since at least 2026-09-26, before GLUE first wrote to Engine DJ. The pen drive's history copy held the user's hand-set cues, and the sync from the computer most likely overwrote them (UNVERIFIED)."}, {"id": "vault_research_engine_dj_write_back_pad_1_cue_restore", "label": "Cue restore into F: (CUE-button cues and pad 1)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Restored from history and Engine DJ's analysis, but only where F: had no cue or only one not set by hand. Grids were left unwritten because the user did not want them. Each step had a backup and an integrity check."}, {"id": "vault_research_engine_dj_write_back_glue_write_policy", "label": "What follows for GLUE: write policy", "file_type": "rationale", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never add playlists to the Collection that the drives do not also get, since differing playlist ids set off 5.3's parent-id bug. GLUE's own library stays separate. Engine's logs are checked after any write. Playlist writes wait for an experiment with a throwaway library."}, {"id": "vault_research_engine_dj_write_back_libdjinterop", "label": "libdjinterop (reference for the blob encoders)", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External open-source reference (beat_data_blob.cpp, quick_cues_blob.cpp, loops_blob.cpp) that the blob formats were matched against."}, {"id": "vault_research_engine_dj_write_back_engine_logs", "label": "Engine DJ session logs", "file_type": "concept", "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One log file per Engine DJ session in its Logs folder. The first place to look after a failure: they showed the merge job, the trackNumber bug and the warnings. To be checked after any write."}], "edges": [{"source": "vault_research_engine_dj_write_back_shared_playlist_tree", "target": "vault_research_engine_dj_write_back_research", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_collection_tree_master", "target": "vault_research_engine_dj_write_back_shared_playlist_tree", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_id_clash_9047", "target": "vault_research_engine_dj_write_back_shared_playlist_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_f_only_glue_writes", "target": "vault_research_engine_dj_write_back_id_clash_9047", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_f_only_glue_writes", "target": "vault_research_engine_dj_write_back_shared_playlist_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_engine_5_3_aggregating_drives", "target": "vault_research_engine_dj_write_back_research", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_parent_id_loop", "target": "vault_research_engine_dj_write_back_engine_5_3_aggregating_drives", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_engine_5_3_aggregating_drives", "target": "vault_research_engine_dj_write_back_engine_logs", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_library_shown_as_drive", "target": "vault_research_engine_dj_write_back_parent_id_loop", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_library_shown_as_drive", "target": "vault_research_engine_dj_write_back_glue_write_policy", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_locked_new_playlists", "target": "vault_research_engine_dj_write_back_shared_playlist_tree", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.55, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_locked_new_playlists", "target": "vault_research_engine_dj_write_back_f_only_glue_writes", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_performance_data", "target": "vault_research_engine_dj_write_back_research", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_quick_cues_blob", "target": "vault_research_engine_dj_write_back_performance_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_loops_blob", "target": "vault_research_engine_dj_write_back_performance_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_beat_data_blob", "target": "vault_research_engine_dj_write_back_performance_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_quick_cues_blob", "target": "vault_research_engine_dj_write_back_libdjinterop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_loops_blob", "target": "vault_research_engine_dj_write_back_libdjinterop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_beat_data_blob", "target": "vault_research_engine_dj_write_back_libdjinterop", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_pen_drive_cue_loss", "target": "vault_research_engine_dj_write_back_performance_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_pad_1_cue_restore", "target": "vault_research_engine_dj_write_back_pen_drive_cue_loss", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_pad_1_cue_restore", "target": "vault_research_engine_dj_write_back_performance_data", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_glue_write_policy", "target": "vault_research_engine_dj_write_back_research", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_glue_write_policy", "target": "vault_research_engine_dj_write_back_collection_tree_master", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_shared_playlist_tree", "target": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_f_only_glue_writes", "target": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_library_shown_as_drive", "target": "vault_adr_0196_glues_own_engine_dj_library_on_a_drive_of_its_own_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}, {"source": "vault_research_engine_dj_write_back_glue_write_policy", "target": "vault_adr_0194_glue_doesnt_write_into_engine_dj_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "hyper_engine_5_3_merge_chain", "label": "Engine DJ 5.3 merge growing to 13 GB", "nodes": ["vault_research_engine_dj_write_back_engine_5_3_aggregating_drives", "vault_research_engine_dj_write_back_parent_id_loop", "vault_research_engine_dj_write_back_engine_logs"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/research/engine-dj-write-back.md"}, {"id": "hyper_glue_write_policy_from_incidents", "label": "GLUE write policy formed from the drive incidents", "nodes": ["vault_research_engine_dj_write_back_f_only_glue_writes", "vault_research_engine_dj_write_back_library_shown_as_drive", "vault_research_engine_dj_write_back_glue_write_policy"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "vault/research/engine-dj-write-back.md"}]}