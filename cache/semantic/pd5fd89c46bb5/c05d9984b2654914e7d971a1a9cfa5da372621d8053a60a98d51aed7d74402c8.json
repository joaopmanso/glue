{"nodes": [{"id": "vault_features_glue_cloud_feature", "label": "GLUE Cloud: accounts, GLUE Home and devices", "file_type": "concept", "source_file": "vault/features/glue-cloud.md"}, {"id": "webrtc_transport_mechanism", "label": "WebRTC data channels: P2P between browser and GLUE Home", "file_type": "rationale", "source_file": "vault/features/glue-cloud.md", "rationale": "Direct when possible (LAN or internet), through a TURN relay when not. DTLS-encrypted end to end. Each device's key signs its DTLS fingerprint (ADR 0037)."}, {"id": "relay_mechanism", "label": "TURN relay: Cloudflare's relay for connections outside LAN", "file_type": "rationale", "source_file": "vault/features/glue-cloud.md", "rationale": "For streaming and sending songs outside home. Free tier: first 1,000 GB/month, then $0.05/GB. Credentials obtained daily from GLUE Cloud (ADR 0081)."}, {"id": "account_concept", "label": "GLUE account: optional Google or email+password sign-in", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "rationale": "Optional tier. Sign in with Google or Apple. The cloud keeps only who you are and which devices you have. Never requires an account; local library unchanged without one."}, {"id": "pairing_mechanism", "label": "Pairing GLUE Home: two ways (code or same account)", "file_type": "rationale", "source_file": "vault/features/glue-cloud.md", "rationale": "Code: the website shows a short code (valid 10 minutes, single use). Same account: GLUE Home opens the browser to sign in with Google."}, {"id": "devices_concept", "label": "Devices: each computer and its GLUE Home listed in sidebar", "file_type": "concept", "source_file": "vault/features/glue-cloud.md", "rationale": "This browser plus each GLUE Home. Can rename or revoke a device. A device without a library opens the account's library from GLUE Cloud (ADR 0077)."}], "edges": [{"source": "vault_features_glue_cloud_feature", "target": "account_concept", "relation": "implements", "confidence": "E