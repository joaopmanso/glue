{"nodes": [{"id": "vault_adr_0178_dj_playlists_stay_in_the_dj_collection_decision", "label": "ADR 0178: A DJ app's playlists stay in its DJ collection; GLUE's own go to its GLUE folder", "file_type": "rationale", "source_file": "vault/adr/0178-dj-playlists-stay-in-the-dj-collection.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ playlists had been merged into GLUE's Playlists, and could not be deleted because they came back on sync. Three kinds: a DJ app's own (in its DJ collection), an import (a copy that follows its library), GLUE's own (mirrored into the app's GLUE folder). Every copy taken out once, with a backup and the bin as recovery. ADR 0171 superseded."}], "edges": [{"source": "vault_adr_0178_dj_playlists_stay_in_the_dj_collection_decision", "target": "vault_adr_0171_engine_dj_playlists_kept_in_step_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0178-dj-playlists-stay-in-the-dj-collection.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0178_dj_playlists_stay_in_the_dj_collection_decision", "target": "vault_adr_0172_engine_dj_order_and_songs_kept_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0178-dj-playlists-stay-in-the-dj-collection.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0178_dj_playlists_stay_in_the_dj_collection_decision", "target": "vault_adr_0063_dj_libraries_browsed_live_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0178-dj-playlists-stay-in-the-dj-collection.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0178_dj_playlists_stay_in_the_dj_collection_decision", "target": "vault_adr_0090_bin_guarded_re_reads_daily_backups_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fi