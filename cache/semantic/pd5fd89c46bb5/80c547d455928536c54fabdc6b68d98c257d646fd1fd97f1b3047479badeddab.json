{"nodes": [{"id": "vault_features_sets_feature", "label": "Feature: Sets (in progress, M10)", "file_type": "document", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_features_sets_one_mixer", "label": "One mixer for the file and the preview", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The set engine is one for the file and the preview: beat clock, tempo map, WSOLA key lock, isolator, filter, echo, equal-power headroom and a gliding look-ahead limiter. It exists in TypeScript and in Rust (crates/glue-sets), held to it by goldens."}, {"id": "vault_features_sets_later_plans", "label": "Later plans for sets", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawn curves (EQ, volume, filter), stems in transitions, FLAC, and Engine DJ cues at the mix points."}, {"id": "vault_features_sets_next_remote_streaming", "label": "Next: remote set streaming (R4)", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A device without the songs gets the set mixed by the GLUE Home that has them, streamed over the session as Opus (about 192 kbps); its export is FLAC that the device writes into WAV or MP3."}], "edges": [{"source": "vault_features_sets_feature", "target": "vault_features_sets_one_mixer", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_features_sets_later_plans", "relation": "conceptuall