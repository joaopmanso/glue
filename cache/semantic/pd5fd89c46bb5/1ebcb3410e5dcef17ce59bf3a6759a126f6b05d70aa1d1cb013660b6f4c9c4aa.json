{"nodes": [{"id": "vault_adr_0129_code_map_docs_every_session_decision", "label": "ADR 0129 code map docs every session", "file_type": "document", "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The vault is the source of truth so the graph's view of it must not go stale; through the skill a refresh costs about 60 KB of instructions per session, and the user wants no extra costs. So refresh in every session that changes docs, with a script and subagents, and browse the graph on the site."}, {"id": "vault_adr_0129_graph_docs_refresh_flow", "label": "graph_docs.py prepare, subagents, finish", "file_type": "concept", "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prepare writes one prompt per batch of 15 from graph-extract.md; one subagent per batch writes .docs_NN.json; finish mends output, fills the semantic cache, updates code, merges, prunes, clusters, saves the manifest and publishes. Failed batches stay unstamped and return next time."}, {"id": "vault_adr_0129_vault_log_excluded", "label": "vault/log excluded from graph", "file_type": "rationale", "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The changelog and handoff change every session and the changelog is long, so re-reading them would make every refresh expensive."}, {"id": "vault_adr_0129_graph_site_view", "label": "Interactive graph view at /graph/", "file_type": "concept", "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graph.html is published with the graph and copied by the site's deploy; the repo is public so nothing new is exposed; a separate Pages deployment would replace the website. May lag one push."}, {"id": "vault_adr_0129_refresh_before_commit", "label": "Refresh runs before the commit", "file_type": "rationale", "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So the post-commit hook (code only) and the refresh never write the graph at once."}], "edges": [{"source": "vault_adr_0129_code_map_docs_every_session_decision", "target": "vault_adr_0128_code_map_built_on_github_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0129_code_map_docs_every_session_decision", "target": "vault_adr_0129_graph_docs_refresh_flow", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0129_code_map_docs_every_session_decision", "target": "vault_adr_0129_vault_log_excluded", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0129_code_map_docs_every_session_decision", "target": "vault_adr_0129_graph_site_view", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0129_code_map_docs_every_session_decision", "target": "vault_adr_0129_refresh_before_commit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0129-code-map-docs-every-session.md", "source_location": 