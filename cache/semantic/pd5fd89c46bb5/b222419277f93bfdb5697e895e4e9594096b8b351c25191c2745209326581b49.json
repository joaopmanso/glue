{"nodes": [{"id": "vault_system_document", "label": "GLUE: How it Works Now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": "1-261", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_website_component", "label": "GLUE Website", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Svelte 5 + TypeScript app on GitHub Pages. Works alone, offline, without an account."}, {"id": "glue_folder_component", "label": "GLUE Folder", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user's data: JSON files, no database. Chosen on first run or kept in browser storage (OPFS) on a device with no folder."}, {"id": "glue_home_component", "label": "GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tauri 2 tray app on the user's computer (Windows, macOS). When it runs, it is the library's engine and the website on that computer is its screen."}, {"id": "glue_cloud_component", "label": "GLUE Cloud", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional account: a Cloudflare Worker with D1 and a Durable Object for signaling. Holds the account's collections (never music), profiles and devices."}, {"id": "glue_session_concept", "label": "GLUE Session", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "153-158", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each device's tab keeps one session with each of the account's other GLUE Homes, opened at sign-in. Kept alive by ping every 15s. Never to this computer's own GLUE Home (ADR 0137). At most 5 other devices, refuses when full."}, {"id": "glue_collection_concept", "label": "GLUE Collection", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "84-130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Music folders, DJ libraries, songs, playlists, analyses, events. In shared form when signed in with cloud sync, lives in GLUE Cloud."}, {"id": "glue_profile_concept", "label": "GLUE Profile", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "72-82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An artist alias: id, name, colour, BPM range. Signed in, the account keeps the list. Each device keeps its own choice."}, {"id": "direct_link_mechanism", "label": "Direct Link to GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local link on 127.0.0.1:47400-47409. The website uses it when on this computer's own GLUE Home for disk access and engine control."}, {"id": "analysis_queue_concept", "label": "Analysis Queue", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "166-169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home's analysis pool processes songs. Network folder songs take turns (4 at a time). Analysis limits set by user, speed shown in GLUE Home."}, {"id": "vault_adr_0133_a_session_per_device_with_glue_home_decision", "label": "ADR 0133: A session per device with GLUE Home", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "source_location": "213", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0125_dropped_songs_placed_by_glue_home_dec