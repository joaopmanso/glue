{"nodes": [{"id": "vault_features_sets_feature", "label": "Feature: Sets, a playlist mixed and exported as one file (M10, in-progress)", "file_type": "document", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_features_sets_who_mixes", "label": "Who mixes the set: GLUE Home or the browser", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home (0.84) mixes whenever it runs and has every song, streamed to the tab for the preview and the file; otherwise the browser mixes. The same mixer in Rust (glue-sets), held to the TypeScript by goldens."}, {"id": "vault_features_sets_engine_one_for_file_and_preview", "label": "One mixing engine for the file and the preview", "file_type": "rationale", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The same engine (beat clock, tempo map, WSOLA key lock, isolator, filter, echo, headroom, look-ahead limiter) serves the exported file and the live preview, so what is heard is what is exported."}, {"id": "vault_features_sets_length_fit", "label": "A set's length asked for, songs shortened, the last left out", "file_type": "rationale", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A length of 30 min to 3 h (or no limit): songs play shorter to fit, and if that is not enough the last songs are left out (ADR 0202)."}], "edges": [{"source": "vault_features_sets_feature", "target": "vault_adr_0197_a_sound_profile_for_every_song_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "wei