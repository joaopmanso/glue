{"nodes": [{"id": "claude_document", "label": "CLAUDE.md: GLUE project instructions", "file_type": "document", "source_file": "CLAUDE.md"}, {"id": "glue_application_concept", "label": "GLUE: Global Library Unified Exporter", "file_type": "concept", "source_file": "CLAUDE.md", "rationale": "Local-first web app for DJs building music collections from folders and DJ-app libraries (Rekordbox, Engine DJ, Traktor, Apple Music), analyzing quality/BPM/key, managing playlists and sessions, finding duplicates, and exporting to DJ apps. Evolved from Speklone spectral forensics."}, {"id": "speklone_concept", "label": "Speklone: spectral forensics predecessor", "file_type": "concept", "source_file": "CLAUDE.md", "rationale": "Original tool for verifying hi-res audio authenticity through spectral analysis. Became GLUE's per-track Inspector and Analyze a File mode."}, {"id": "vault_is_source_of_truth_rationale", "label": "The vault is the source of truth for GLUE development", "file_type": "rationale", "source_file": "CLAUDE.md"}, {"id": "mco_internal_ids_convention", "label": "mco internal identifier prefix", "file_type": "concept", "source_file": "CLAUDE.md", "rationale": "Internal identifiers use prefix mco (mco.json, mco-backup.json, IndexedDB mco, prefs mco.*, picker ids mco-home) for backward compatibility with existing data folders and backups."}, {"id": "local_first_principle", "label": "No GLUE server that sees your music (non-negotiable)", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "Website works standalone, accounts optional, audio flows only between user's own computers. GLUE Home is user's own program on their computer; when running, the website uses it as disk and engine over local link."}, {"id": "json_files_storage_rationale", "label": "GLUE's data is JSON files, no database (non-negotiable)", "file_type": "rationale", "source_file": "CLAUDE.md"}, {"id": "one_writer_principle_rationale", "label": "One writer of the GLUE folder at a time (non-negotiable)", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "Tab in Home mode writes only while holding GLUE Home's lease; GLUE Home writes only while no lease is held."}, {"id": "platform_abstraction_rationale", "label": "OS access only through src/platform/ (non-negotiable)", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "All OS interactions restricted to src/platform/ module: browser handles or GLUE Home's disk in Home mode."}, {"id": "src_core_module_concept", "label": "src/core: pure logic", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "No DOM. Contains audio, formats, stems, interop (DJ-library parsers), library (scan, tags, path matching, analysis summary)."}, {"id": "src_store_module_concept", "label": "src/store: JSON store", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "Home, collection, merge of imports/scans, migrations."}, {"id": "src_platform_module_concept", "label": "src/platform: OS access layer", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "Folder access and IndexedDB handles."}, {"id": "src_lib_module_concept", "label": "src/lib: state and orchestration", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "library.svelte.ts (library state), lib/library/*.ts (methods by concern), pool.ts (background analysis), app.svelte.ts (analyze-a-file), player, stems, route, view."}, {"id": "src_ui_module_concept", "label": "src/ui: components and renderers", "file_type": "code", "source_file": "CLAUDE.md"}, {"id": "crates_glue_engine_crate_concept", "label": "crates/glue-engine: GLUE Home's library engine", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "Rust implementation (ADR 0153, 0154). Local link /rpc, stores, jobs, repair, analysis queue. Hosted in GLUE Home, binary runs in e2e tests."}, {"id": "crates_glue_audio_crate_concept", "label": "crates/glue-audio: native analysis engine", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "ADR 0147: line-for-line Rust port of src/core analysis with JavaScript numbers. Verified against TypeScript in tests/golden."}, {"id": "crates_glue_store_crate_concept", "label": "crates/glue-store: library store in Rust", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "ADR 0152: byte-for-byte match to src/store/collection.ts verified by tests/golden/store."}, {"id": "crates_glue_rtc_crate_concept", "label": "crates/glue-rtc: GLUE Home's connections to other devices", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "ADR 0150: webrtc-rs speaking website protocol (src/core/transfer.ts)."}, {"id": "cloud_component_concept", "label": "cloud: GLUE Cloud Worker", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "API, D1 migrations, signaling Durable Object. Deployed via .github/workflows/cloud.yml."}, {"id": "home_component_concept", "label": "home: GLUE Home Tauri 2 tray app", "file_type": "code", "source_file": "CLAUDE.md", "rationale": "ADR 0044. home/src-tauri (Rust: tray, settings, folders, autostart, local.rs on 127.0.0.1:47400-47409) and home/ui (settings window, drag dock)."}, {"id": "home_ui_component_concept", "label": "home/ui: GLUE Home UI windows", "file_type": "code", "source_file": "CLAUDE.md"}, {"id": "graphify_documentation_process_concept", "label": "Graphify documentation refresh process (ADR 0129)", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "When docs in code map change (ADRs, features, SYSTEM.md, etc.), refresh before commit using scripts/graph_docs.py prepare (one subagent per batch), then scripts/graph_docs.py finish to publish."}, {"id": "gluey_help_and_tour_system", "label": "Gluey: help articles and tours (ADR 0126)", "file_type": "rationale", "source_file": "CLAUDE.md", "rationale": "When feature changes, update help article (src/help/*.md) and tour (src/core/guide/tours.ts with data-guide attributes). tests/guide.test.ts verifies existence."}], "edges": [{"source": "c