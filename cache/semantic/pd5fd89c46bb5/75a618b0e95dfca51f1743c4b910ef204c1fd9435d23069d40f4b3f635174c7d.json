{"nodes": [{"id": "vault_features_quality_forensics_feature", "label": "Quality forensics", "file_type": "document", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0002_static_client_only_app_decision", "label": "ADR 0002: No GLUE server sees music", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-negotiable privacy principle: no GLUE server sees user's music; the website works independently with optional accounts"}, {"id": "vault_adr_0033_tolerate_gentle_roll_offs_decision", "label": "ADR 0033: Tolerate gentle roll-offs", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lossless file whose top end fades gently (no wall) from 17 kHz up is Lossless with a Note; below 17 kHz it's a Caution"}, {"id": "vault_adr_0034_quiet_content_above_the_fade_decision", "label": "ADR 0034: Quiet content above the fade", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fade below 17 kHz is still Lossless when quiet content (hats, cymbals) reaches 17 kHz or higher in louder moments"}, {"id": "vault_adr_0069_content_beyond_a_wall_decision", "label": "ADR 0069: Content beyond a wall", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A lossless file with a wall but content beyond it (loud moments well above floor) is a caution, not Transcoded"}, {"id": "vault_adr_0075_drop_outs_under_a_wall_decision", "label": "ADR 0075: Drop-outs under a wall", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MP3 encoders switch off the band under their lowpass in loud moments; drop-outs in 12%+ of loud moments make a wall a transcode"}, {"id": "vault_adr_0116_hi_res_by_what_reaches_past_24_khz_decision", "label": "ADR 0116: Hi-res by what reaches past 24 kHz", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hi-res judged by ultrasonic content: past 30 kHz is genuine; stopping by 28.5 kHz with a 30 dB cliff indicates upsampling"}, {"id": "vault_adr_0118_mastering_lowpass_from_17_khz_decision", "label": "ADR 0118: Mastering lowpass from 17 kHz", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A mastering lowpass with no drop-outs and content above following the music is Lossless; replaced by ADR 0119"}, {"id": "vault_adr_0119_content_beyond_a_wall_is_lossless_decision", "label": "ADR 0119: Content beyond a wall is lossless", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the band under a wall not switching off often (< 12% of loud moments), content beyond is Lossless (supersedes ADR 0118)"}, {"id": "vault_adr_0166_glue_home_rechecks_verdicts_and_tidies_decision", "label": "ADR 0166: GLUE Home rechecks verdicts and tidies", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stored verdicts are re-checked from stored analyses when verdict rules change; GLUE Home does this once a run"}, {"id": "spectral_forensics_verdict_mechanism", "label": "Spectral forensics and verdict classification", "file_type": "rationale", "source_file": "vault/features/quality-forensics.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "STFT analysis (Hann window, 4096\u201316384 points) \u2192 frequency spectrum \u2192 cutoff detection (brick wall \u226518 dB drop) \u2192 verdict classification"}], "edges": [{"source": "vault_features_quality_forensics_feature", "target": "vault_adr_0002_static_client_only_app_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/quality-forensics.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_quality_forensics_feature", "target": "vault_adr_0033_tolerate_gentle_roll_offs_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/quality-forensics.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_quality_forensics_feature", "target": "vault_adr_0034_quiet_content_above_the_fade_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/quality-forensics.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_quality_forensics_feature", "target": "vault_adr_0069_content_beyond_a_wall_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/quality-forensics.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_quality_forensics_feature", "target": "vault_adr_0075_drop_outs_under_a_wall_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/fe