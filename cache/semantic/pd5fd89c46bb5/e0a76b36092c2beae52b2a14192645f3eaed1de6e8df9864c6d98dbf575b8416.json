{"nodes": [{"id": "vault_adr_0202_a_sets_length_layering_and_timeline_gestures_decision", "label": "ADR 0202: A set's length asked for, layering on 3 decks, and the timeline's gestures", "file_type": "rationale", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asked by the user on 2026-11-27 on the set builder: the wheel zooms, a click selects a song before it can move, the time bar alone seeks, a length can be chosen, and 3 decks mean two alike songs play together with a third mixing in."}, {"id": "sets_length_asked_for", "label": "Set length asked for (30 min to 3 h, or no limit)", "file_type": "rationale", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shorter songs come first, as a DJ would play them: dropping whole songs first would lose songs the user picked while others play long. Each song plays the same share (never under 40 %), and only if even that is too long do songs come off the end."}, {"id": "sets_layering_on_three_decks", "label": "Layering songs that sound alike on 3 decks", "file_type": "rationale", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layering every pair is clutter: two unrelated songs at full for 48 bars. Only close-sounding pairs are layered (likeness >= 0.72, tempo within 4 %, keys that fit), so the second comes in early and the third at least 16 bars before the first goes."}, {"id": "sets_layer_handover_style", "label": "Layer hand-over style (8-bar rise without bass, then bass swap)", "file_type": "concept", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sets_timeline_gestures", "label": "Timeline gestures: wheel zoom, drag to scroll, select then move", "file_type": "rationale", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plain wheel zooms rather than Ctrl+wheel, since the timeline does not scroll up and down so nothing is lost. A click selects a song, so it cannot move by accident; the time bar alone seeks."}, {"id": "sets_handover_chip_box", "label": "Hand-over chip box on the timeline", "file_type": "concept", "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0202_a_sets_length_layering_and_timeline_gestures_decision", "target": "vault_adr_0197_a_sound_profile_for_every_song_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0202_a_sets_length_layering_and_timeline_gestures_decision", "target": "vault_adr_0198_playlists_that_follow_a_flow_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0202_a_sets_length_layering_and_timeline_gestures_decision", "target": "vault_adr_0199_a_set_is_a_playlist_mixed_by_one_engine_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0202-a-sets-length-layering-and-timeline-gestures.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr