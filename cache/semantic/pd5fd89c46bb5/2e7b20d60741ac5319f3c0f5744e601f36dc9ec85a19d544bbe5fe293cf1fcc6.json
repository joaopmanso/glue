{"nodes": [{"id": "vault_system_document", "label": "SYSTEM.md: how GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Says how GLUE works today in one place; a change that alters it updates this file in the same commit."}, {"id": "vault_system_glue_home_engine", "label": "GLUE Home as the library's engine", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When GLUE Home runs it is the library's engine and the website on that computer is its screen; the engine is Rust."}, {"id": "vault_system_engine_dj_writes_off", "label": "Engine DJ writes off (GLUE Home 0.80)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unless the settings say engineWrites: true, the sync does not run, djEdit is refused and the page offers nothing that writes. Reading and following stay."}, {"id": "vault_system_dj_libraries_rust", "label": "DJ libraries in GLUE Home (Rust)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home reads, imports and follows DJ libraries in Rust, held byte for byte to the website's parsers; the page only shows state and asks for Refresh."}, {"id": "vault_system_main_dj_library", "label": "Main DJ library (0.66)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per computer. A song's BPM is GLUE's correction, then the main library's grid, then the analysis; its grid and cues are GLUE's own first, else the main library's."}, {"id": "vault_system_dj_playlists_stay", "label": "DJ playlists stay in their DJ collection (0.71)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE's copies of DJ playlists are imports again, following the library one way; GLUE's own playlists go to a GLUE folder in Engine DJ. The three-way playlist merge is parked."}], "edges": [{"source": "vault_system_document", "target": "vault_system_glue_home_engine", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "vault_system_engine_dj_writes_off", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "vault_system_dj_libraries_rust", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "vault_system_main_dj_library", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "vault_system_dj_playlists_stay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "src_store_collection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "src_store_fsx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, 