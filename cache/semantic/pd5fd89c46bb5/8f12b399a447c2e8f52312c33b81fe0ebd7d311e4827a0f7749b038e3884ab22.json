{"nodes": [{"id": "vault_adr_0145_one_rule_for_the_same_name_decision", "label": "ADR 0145: Judge the same name one way, in core/library/names.ts", "file_type": "rationale", "source_file": "vault/adr/0145-one-rule-for-the-same-name.md", "rationale": "Five functions decided whether two names were the same independently, causing Duplicates, No file linked, joining, and cover lookup to disagree on what is the same song. Consolidate in core/library/names.ts with three rules: fold (collection joining), songName (duplicates and relink), bare (cover lookup), eliminating inconsistencies like Frankie & Johnny vs. And Johnny."}, {"id": "song_name_rule", "label": "songName: normalized name for Duplicates and No file linked", "file_type": "concept", "source_file": "vault/adr/0145-one-rule-for-the-same-name.md"}, {"id": "fold_rule", "label": "fold: lowercase letters and digits without accents", "file_type": "concept", "source_file": "vault/adr/0145-one-rule-for-the-same-name.md"}, {"id": "bare_rule", "label": "bare: name without brackets for cover lookup", "file_type": "concept", "source_file": "vault/adr/0145-one-rule-for-the-same-name.md"}], "edges": [{"source": "vault_adr_0145_one_rule_for_the_same_name_decision", "target": "song_name_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0145-one-rule-for-the-same-name.md", "weight": 1.0}, {"source": "vault_adr_0145_one_rule_for_the_same_name_decision", "target": "fold_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0145-one-rule-for-the-same-name.md", "weight": 1.0}, {"source": "vault_adr_0145_one_rule_for_the_same_name_decision", "target": "bare_rule", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0145-one-rule-for-the-same-name.md", "weight": 1.0}], "hyperedges": [{"id": "name_comparison_rules_system", "label": "Name comparison rules system", "node