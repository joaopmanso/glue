{"nodes": [{"id": "claude_non_negotiables", "label": "Non-negotiables: no GLUE server sees the music, JSON data, one writer", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Audio goes only between the user's own computers. GLUE's data is JSON files in the user's GLUE folder, no database. OS access only through src/platform. One writer of the GLUE folder at a time, governed by GLUE Home's lease."}, {"id": "claude_routes_set", "label": "Route #/set/<id>: a playlist mixed as a set", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gluey_help_and_tours", "label": "Gluey rule: a feature's help article and tour are updated with it", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a feature changes, its help article (src/help/*.md) and its tour (src/core/guide/tours.ts) change too; tests/guide.test.ts checks the data-guide attributes exist (ADR 0126)."}, {"id": "claude_graphify_code_map", "label": "graphify code map: affected, explain and path, never query", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lookups use the fixed rules; a natural-language query is a padded node dump. The code map is built on GitHub for every push (ADR 0127, 0128)."}], "edges": [{"source": "claude_non_negotiables", "target": "vault_adr_0009_json_files_store_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_non_negotiables", "target": "vault_adr_0051_glue_home_as_local_engine_decision", "r