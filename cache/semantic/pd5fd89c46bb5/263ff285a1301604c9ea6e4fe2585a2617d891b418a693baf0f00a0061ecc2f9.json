{"nodes": [{"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_decision", "label": "ADR 0203: Whose bass plays in a hand-over: chosen, and where it changes hands, moved", "file_type": "rationale", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user asked for the ability to choose which song has full bass, even more than one at once for a double bass effect. They chose per hand-over, plus a swap point dragged on the timeline. The styles already hand the bass over at a point (bass swap, layer, double drop) or keep both basses (blend, filter, echo); a cut switches at its end."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_fx_bass", "label": "SetItem.fx.bass: whose bass plays (auto, out, in, both)", "file_type": "concept", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "auto is the style's; out is the outgoing song's all through, the incoming one's held back; in is the reverse; both is double bass."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_fx_swap", "label": "SetItem.fx.swap: the beat where the bass changes hands", "file_type": "concept", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beats into the hand-over, on a bar line. It applies when bass is auto, in any style."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_handover_rule", "label": "handOver rule: the style's controls first, then only the lows overridden", "file_type": "rationale", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volumes stay the style's; two basses at full are handled by the equal-power headroom of ADR 0201."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_bass_swap_at", "label": "bassSwapAt(fx, len): the moved swap point, else the style's own, else none", "file_type": "concept", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_timeline_marker", "label": "Orange bass marker and dashed line on the timeline", "file_type": "concept", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shown on the open hand-over. Dragging it moves the swap a bar at a time and sets the choice back to Auto."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_box_row", "label": "Bass row in the hand-over box: Auto, Outgoing, Incoming, Both", "file_type": "concept", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto also forgets a moved swap point."}, {"id": "vault_adr_0203_whose_bass_plays_in_a_hand_over_legacy_plans", "label": "Plans made before keep the style's bass", "file_type": "rationale", "source_file": "vault/adr/0203-whose-bass-plays-in-a-hand-over.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plans made before have bass and swap absent, so they keep the style's bass. A blend, filter or echo has no marker until its bass goes to one side; Both is what it already does."}], "edges": [{"source": "vault_adr_0203_whose_bass_plays_in_a_hand_over_decision", "target": "vault_adr_0203_whose_bass_plays_in_a_hand_over_fx_bass", "relation": "implements", "confidence": "