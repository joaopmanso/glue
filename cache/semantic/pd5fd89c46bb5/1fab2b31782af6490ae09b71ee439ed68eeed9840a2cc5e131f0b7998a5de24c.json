{"nodes": [{"id": "vault_adr_0200_planning_a_set_on_phrases_decision", "label": "ADR 0200: Plan a set's hand-overs on phrases, in the set's style", "file_type": "rationale", "source_file": "vault/adr/0200-planning-a-set-on-phrases.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A set needs every hand-over placed before anything can be heard or exported. Hand-overs at a fixed time before the end fall off the phrase, often in the middle of a vocal or a drop. Searching every pair of mix points for the best energy match is deferred: phrases from the grid plus the outro rule give the hand-overs a DJ would pick most of the time, and the user can move them."}], "edges": [{"source": "vault_adr_0200_planning_a_set_on_phrases_decision", "target": "vault_adr_0199_a_set_is_a_playlist_mixed_by_one_engine_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0200-planning-a-set-on-phrases.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0200_planning_a_set_on_phrases_decision", "target": "vault_adr_0197_a_sound_profile_for_every_song_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0200-planning-a-set-on-phrases.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0200_planning_a_set_on_phrases_decision", "target": "src_core_sets_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0200-planning-a-set-on-phrases.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0200_planning_a_set_on_phrases_decision", "target": "vault_features_sets_planning", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0200-planning-a-set-on-phrases.md", "source_location": null, "weight": 1.0}], "hyperedges": []}