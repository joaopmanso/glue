{"nodes": [{"id": "vault_system_md_document", "label": "GLUE: how it works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_website_component", "label": "Website: Svelte 5 + TypeScript on GitHub Pages", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The main GLUE application runs as a web app on GitHub Pages, works offline and without an account"}, {"id": "glue_folder_structure_concept", "label": "GLUE folder: user's data as JSON files", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No database; JSON files in user's GLUE folder chosen on first run (ADR 0009)"}, {"id": "glue_home_component", "label": "GLUE Home: Tauri 2 tray app for library engine and analysis", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs on user's computer (Windows, macOS); when running, it is the library's engine and the website is its screen (ADR 0104)"}, {"id": "glue_cloud_component", "label": "GLUE Cloud: optional account service on Cloudflare", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "1.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worker with D1 and Durable Object; holds account's collections, profiles and devices; never music"}, {"id": "track_entity_concept", "label": "Track: a song in the library", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Has status (linked, missing, unlinked), location (rootId + relPath), tags, rating, prep (BPM, grid, cues), unwritten info"}, {"id": "collection_store_concept", "label": "CollectionStore: loads and keeps maps of library files", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One per open collection; loads files and keeps maps (tracks, analysis, lists, sources); writes only changed files, marked per shard and debounced"}, {"id": "shared_form_concept", "label": "Shared form: collections synced across devices", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signed in with cloud sync; collection is the account's; collection.json has shared, members and rootsBy; songs have copies per computer (ADR 0130)"}, {"id": "analysis_system_concept", "label": "Analysis: quality verdict, fingerprint, waveform, spectrogram", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in GLUE Home natively (Rust, ADR 0148) or in browser worker pool; produces summary (verdict, tier, bandwidth, bit depth, BPM, key)"}, {"id": "duplicates_system_concept", "label": "Duplicates: fingerprints and name-based matching", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "6.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches by fingerprint (same recording) and artist + title (probable); only copies of same version count; best copy shown everywhere but Duplicates"}, {"id": "dj_library_sync_concept", "label": "DJ library sync: bidirectional with Engine DJ", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "5.11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One DJ sync at a time (0.72.1); merges hot cues, saved loops and grid three ways; writes only while app is closed (ADR 0170)"}, {"id": "local_link_concept", "label": "Local link: 127.0.0.1:47400-47409 for GLUE Home access", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides /hello, /connect, /fs/*, /cache, /rpc, /lease, /attach endpoints; every route except /hello and /connect needs token (ADR 0048)"}, {"id": "profiles_concept", "label": "Profiles: artist aliases with id, name, colour, BPM range", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User sees these on Who's using GLUE?; account keeps the union of every device's profiles; each device keeps its own choice (ADR 0113, 0114)"}, {"id": "home_engine_rust_component", "label": "GLUE Home engine in Rust: store, sync, analysis queue, jobs", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "5.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Since 0.52; one engine for whole run; applies tab edits over /rpc edit, saves to disk, feeds changes back (ADR 0153, 0154)"}, {"id": "verdict_system_concept", "label": "Quality verdicts: forensic analysis of audio content", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "6.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hi-res judged by ultrasonic content past 24 kHz; steep top end with music-following content is genuine; sharp drops are upsampling (ADR 0116, 0119)"}, {"id": "glue_audio_native_engine", "label": "glue-audio: native Rust analysis engine", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "6.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Line-for-line Rust port of TypeScript analysis; used by GLUE Home; held byte-for-byte by tests/golden (ADR 0147)"}, {"id": "webrtc_streaming_concept", "label": "WebRTC streaming: songs sent to other devices via signaling", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "5.12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Other device keeps songs in browser storage; streams from computers that have them over WebRTC signaled through GLUE Cloud (ADR 0077)"}, {"id": "collection_store_file", "label": "CollectionStore implementation in TypeScript", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "2.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_store_crate", "label": "glue-store: library store in Rust", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "5.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Held byte-for-byte to TypeScript by tests/golden/store (ADR 0152)"}, {"id": "glue_interop_crate", "label": "glue-interop: DJ libraries in Rust", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "5.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads Rekordbox XML, Traktor NML, Apple Music XML, Serato, Engine DJ m.db, M3U; held to TypeScript by tests/golden/interop (ADR 0167)"}, {"id": "glue_rtc_crate", "label": "glue-rtc: WebRTC connections in Rust", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "5.13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Peer connections, channels, pings, uploads, cache files, song bytes (ADR 0150)"}, {"id": "tauri_config", "label": "GLUE Home Tauri configuration and setup", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": "1.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version in tauri.conf.json, Cargo.toml, Cargo.lock; new version on push to main builds and publishes signed release (tag home-v<version>)"}], "edges": [{"source": "vault_system_md_document", "target": "glue_website_component", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "1.1", "weight": 1.0}, {"source": "vault_system_md_document", "target": "glue_folder_structure_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "2", "weight": 1.0}, {"source": "vault_system_md_document", "target": "glue_home_component", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "1.2", "weight": 1.0}, {"source": "vault_system_md_document", "target": "glue_cloud_component", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "1.3", "weight": 1.0}, {"source": "glue_home_component", "target": "home_engine_rust_component", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "5.7", "weight": 1.0}, {"source": "home_engine_rust_component", "target": "glue_store_crate", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "5.7", "weight": 1.0}, {"source": "home_engine_rust_component", "target": "glue_interop_crate", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "5.8", "weight": 1.0}, {"source": "home_engine_rust_component", "target": "glue_rtc_crate", "relation": "uses", "co