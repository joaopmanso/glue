{"nodes": [{"id": "vault_adr_0137_this_computer_never_a_remote_session_decision", "label": "ADR 0137: This computer's browser is never a remote session, and isn't counted; the direct link isn't dropped on one slow answer", "file_type": "rationale", "source_file": "vault/adr/0137-this-computer-never-a-remote-session.md", "source_location": "1-47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A failed request to GLUE Home was dropping the direct link when it didn't answer within 1.5s. The browser was then opening a remote session to this computer's GLUE Home (counted against session limit) when analysis load slowed responses. Solution: never open remote session to own computer, let own browser in always (not counted), and only drop link after two failed checks (3s then 5s)."}, {"id": "remote_session_concept", "label": "Remote Session", "file_type": "concept", "source_file": "vault/adr/0137-this-computer-never-a-remote-session.md", "source_location": "23-24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A connection from another device to this computer's GLUE Home, counted against session limit. Must be distinguished from the direct link used by this computer's own browser."}, {"id": "home_ui_sessions_ts_code", "label": "home/ui/sessions.ts", "file_type": "code", "source_file": "vault/adr/0137-this-computer-never-a-remote-session.md", "source_location": "32", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0137_this_computer_never_a_remote_session_decision", "target": "vault_adr_0133_a_session_per_device_with_glue_home_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0137-this-computer-never-a-remote-session.md", "source_location": "24", "weight": 1.0}, {"source": "vault_adr_0137_this_computer_never_a_remote_session_decision", "target": "vault_adr_0125_d