{"nodes": [{"id": "vault_features_themes_feature", "label": "Themes feature (in progress, M2)", "file_type": "document", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choose how GLUE looks: a theme plus dark, light or match-the-system mode. Still open: the user tries Studio, Riso and Moss and picks the new default."}, {"id": "vault_features_themes_hallmark_console_treatment", "label": "Hallmark's Console treatment (ADR 0191)", "file_type": "rationale", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every theme keeps its colours. Labels are sentence case and untracked; mono only for what was measured (BPM, key, kHz, times, paths); disabled controls change fill, ink and cursor."}, {"id": "vault_features_themes_glue_stick_theme", "label": "GLUE Stick theme, the default since 2026-09-25", "file_type": "concept", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user asked for it and chose it as default: glue-stick yellow on black. Light mode uses a darker gold so accent text stays readable. Heavy Archivo titles, 10 px corners."}, {"id": "vault_features_themes_theme_picker", "label": "Theme picker in Who's using GLUE? Appearance", "file_type": "concept", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows the themes with live previews and a Dark / Light / Match system switch. The header's sun/moon button flips dark and light anywhere. The choice is remembered in the browser and the GLUE folder (ADR 0028)."}, {"id": "vault_features_themes_shared_tokens", "label": "Shared theme tokens (--stage, --scrim, --shadow-pop)", "file_type": "concept", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defined in the theme table; app.css holds the --brand-* tokens for the logo and Gluey and the --field-* tokens for the homepage."}, {"id": "vault_features_themes_logo_accent", "label": "Logo takes the theme's accent", "file_type": "concept", "source_file": "vault/features/themes.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The logo's tube takes the theme's accent, so it is yellow in GLUE Stick. Its glue is always cream and its band always dark, so it reads in every theme."}], "edges": [{"source": "vault_features_themes_feature", "target": "vault_adr_0028_themes_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/themes.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_themes_feature", "target": "vault_adr_0191_hallmark_console_treatment_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/themes.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_themes_hallmark_console_treatment", "target": "vault_features_themes_feature", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/themes.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_themes_hallmark_console_treatment", "target": "vault_adr_0191_hallmark_console_treatment_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/themes.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_themes_glue_stick_theme", "target": "vault_features_themes_feature", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "so