{"nodes": [{"id": "vault_features_exports_feature", "label": "Exports to DJ software (feature)", "file_type": "document", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_features_exports_glue_playlists_engine_dj", "label": "Engine DJ gets GLUE's playlists by itself (0.82)", "file_type": "concept", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home writes the lists marked Keep in Engine DJ into its own Engine DJ library while Engine DJ is closed; Engine DJ merges it into the Collection's GLUE folder at each start. Checked by hand with the user in Engine DJ 5.3 on 2026-11-26."}, {"id": "vault_features_exports_rekordbox_xml", "label": "The rekordbox XML is GLUE Home's, on this computer", "file_type": "concept", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept by GLUE Home on this computer, not in the GLUE folder, because its paths are this computer's; by default Music/GLUE/GLUE.xml. Songs not on this computer are left out and counted."}, {"id": "vault_features_exports_setup_guides", "label": "One-time setup guides for Rekordbox and Engine DJ", "file_type": "concept", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shown in the Export Center with screenshots: Rekordbox's Imported Library setting, and Engine DJ's rekordbox preference pointing at the same file."}, {"id": "vault_features_exports_drag_out", "label": "Drag out to other apps (DownloadURL)", "file_type": "concept", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In Chrome and Edge a track's grip drags out a copy of the file, and a playlist's icon drags out an m3u8 with absolute paths (ADR 0027). A dropped track would be a copy, so the rekordbox XML remains the proper route."}, {"id": "vault_features_exports_planned_formats", "label": "Traktor NML, M3U8 and the quality policy (not yet)", "file_type": "concept", "source_file": "vault/features/exports.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Planned: per-list Traktor NML and M3U8 files, and a per-export quality policy (include all, skip tier E, or swap each track for its preferred duplicate)."}], "edges": [{"source": "vault_features_exports_feature", "target": "vault_features_exports_glue_playlists_engine_dj", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/exports.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_exports_feature", "target": "vault_features_exports_rekordbox_xml", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/exports.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_exports_feature", "target": "vault_features_exports_setup_guides", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/exports.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_exports_feature", "target": "vault_features_exports_drag_out", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/exports.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_exports_feature", "target": "vault_features_exports_planned_formats", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vaul