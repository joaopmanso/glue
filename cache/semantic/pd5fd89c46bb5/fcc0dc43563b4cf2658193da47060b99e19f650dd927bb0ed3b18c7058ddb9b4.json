{"nodes": [{"id": "vault_adr_0177_opening_shows_its_progress_decision", "label": "ADR 0177: Opening the library or a collection shows its progress, and waits less", "file_type": "rationale", "source_file": "vault/adr/0177-opening-shows-its-progress.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A black screen with text for 5-10 s looked broken. What is opening is state (lib.loading) shown as a card with a bar and a top line on every page; file reads take two calls each instead of eight, 32 at a time; GLUE Home is looked for on its ten ports in parallel. Not opening the library without GLUE Home, since the tab and GLUE Home would both write the GLUE folder."}, {"id": "e2e_library_spec", "label": "e2e/library.spec.ts", "file_type": "code", "source_file": "vault/adr/0177-opening-shows-its-progress.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_ui_library_opening", "label": "src/ui/library/Opening.svelte", "file_type": "code", "source_file": "vault/adr/0177-opening-shows-its-progress.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_ui_toploading", "label": "src/ui/TopLoading.svelte", "file_type": "code", "source_file": "vault/adr/0177-opening-shows-its-progress.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0177_opening_shows_its_progress_decision", "target": "vault_adr_0051_glue_home_as_local_engine_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0177-opening-shows-its-progress.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0177_opening_shows_its_progress_decision", "target": "vault_adr_0137_this_computer_never_a_remote_session_decision", "relation": "cites", "confidence": "EXT