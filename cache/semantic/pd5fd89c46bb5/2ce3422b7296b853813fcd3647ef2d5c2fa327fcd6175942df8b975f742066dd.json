{"nodes": [{"id": "vault_adr_0128_code_map_built_on_github_decision", "label": "ADR 0128 code map built on GitHub", "file_type": "document", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sessions should not depend on a local build; CI builds the code part for every push and publishes to the branch graphify. Usage follows colleagues' rules adapted: affected, god-nodes, explain, path; never query; never the skill for questions. A branch is fetched with plain git, unlike expiring artifacts or per-push releases; commit to main rejected for churn."}, {"id": "vault_adr_0128_graphify_branch", "label": "Branch graphify (one replaced commit)", "file_type": "concept", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds graph.json, report, manifest, labels and caches in one commit replaced each time, so no history grows and no workflow runs on it."}, {"id": "vault_adr_0128_graph_mjs_fetch_publish", "label": "graph.mjs fetch and publish", "file_type": "concept", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the graph between graphify-out and the branch with git alone through a private index; the repo's index and working tree are never touched."}, {"id": "vault_adr_0128_usage_rules", "label": "Code map usage rules", "file_type": "rationale", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A broad query returned a 400-node dump while affected --depth 2 was about 750 bytes and found the ADR and SYSTEM.md sections; graphify's own hook said MANDATORY query, contradicting the rules, so it was removed."}, {"id": "vault_adr_0128_session_hooks", "label": "Claude Code session-start fetch and grep nudge hooks", "file_type": "concept", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_adr_0128_semantic_pass_no_ci_key", "label": "Semantic docs pass not in CI", "file_type": "rationale", "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CI has no LLM key; a paid key per push is the user's call, so the docs part came from a Claude Code session then publish."}], "edges": [{"source": "vault_adr_0128_code_map_built_on_github_decision", "target": "vault_adr_0127_graphify_code_map_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0128_code_map_built_on_github_decision", "target": "vault_adr_0129_code_map_docs_every_session_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0128_code_map_built_on_github_decision", "target": "github_workflows_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0128_code_map_built_on_github_decision", "target": "scripts_graph", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0128-code-map-built-on-github.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0128_code_map_built_on_github_decision", "target": "claude_setting