{"nodes": [{"id": "vault_features_discogs_feature", "label": "Discogs feature", "file_type": "document", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shipped in milestone M8: connect a token, read the collection and wantlist, match records to songs, covers, Discogs playlists and the builder. Not yet: devices without GLUE Home; giving a matched record's cover to its songs without a search."}, {"id": "vault_features_discogs_token", "label": "Discogs personal access token", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated on discogs.com (Settings, Developers), pasted in GLUE Home's settings, checked with Discogs ('Connected as'), kept on this computer and sent to Discogs' API only (ADR 0186)."}, {"id": "vault_features_discogs_reading", "label": "Reading the Discogs lists", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home reads the lists 100 a page, one request every 1.1 s, after the token is checked, again after 20 hours (an hourly look) and on Refresh. Each record's tracklist is read once, after its covers; what is missing is fetched at the hourly look even when the list is fresh (0.79). Kept in profiles/<p>/discogs.json."}, {"id": "vault_features_discogs_track_matching", "label": "Track-by-track matching", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A track matches a song by title and version, the track's or the record's artist, and a length within 8 s. Before a tracklist is read, the record's title counts as the songs' album by one of its artists, a compilation on its label, or a single by its title. The user's own choices come first (discogsMatch.ts on the page)."}, {"id": "vault_features_discogs_playlists", "label": "Discogs playlists", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mix the user's songs (they play) with vinyl tracks (cover, side, label, catalogue number, On vinyl). Kept under Discogs, out of the library's playlists, pickers, Engine DJ and exports. Arranged by hand. The live-rules auto playlists of ADR 0189 are no longer made."}, {"id": "vault_features_discogs_playlist_builder", "label": "Discogs playlist builder", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds first, then tracks scored against what the seeds share: styles above all, then genres, the same label, years near, the seeds' or asked artists, BPM when both have it. Short of tracks, the rules relax in steps, each said. Surprise me mixes it up. A track can be swapped or removed; Save makes a Discogs playlist (ADR 0190)."}, {"id": "vault_features_discogs_covers", "label": "Discogs covers", "file_type": "concept", "source_file": "vault/features/discogs.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discogs is the fourth cover service, after Deezer, iTunes and MusicBrainz, for songs whose tags have no cover. Songs that found nothing before the token was connected are looked up again once."}], "edges": [{"source": "vault_features_discogs_feature", "target": "vault_adr_0186_discogs_covers_with_the_users_token_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/discogs.md", "source_location": null, "weight"