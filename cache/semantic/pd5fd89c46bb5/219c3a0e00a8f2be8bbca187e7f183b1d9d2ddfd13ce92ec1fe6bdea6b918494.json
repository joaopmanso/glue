{"nodes": [{"id": "vault_features_prepare_feature", "label": "Prepare (track page tab) feature", "file_type": "document", "source_file": "vault/features/prepare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The track page's Prepare tab: waveform, grid, metronome, tempo, cues and loops, DJ-app cues. Corrections override the analysis (ADR 0052)."}, {"id": "vault_features_prepare_dj_apps", "label": "Cues, loops and grids from the DJ apps", "file_type": "concept", "source_file": "vault/features/prepare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows each DJ library's cues, loops and grid and takes them on a click. Since 2026-11-25 GLUE writes nothing into Engine DJ; Prepare still shows and takes Engine DJ's cues and grids."}, {"id": "vault_features_prepare_vinyl_scrub", "label": "Vinyl scrubbing on the deck", "file_type": "concept", "source_file": "vault/features/prepare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dragging the deck sounds like a hand on a record; the player takes over on release. Until the track is decoded for it, dragging seeks."}, {"id": "vault_features_prepare_kept_in_step", "label": "Engine DJ kept in step both ways (cues, grid)", "file_type": "concept", "source_file": "vault/features/prepare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With the main Engine DJ library's syncing on, Prepare's pads, memory loops and grid go into Engine DJ once closed and its changes come here; a song changed on both shows a clash banner. Off since ADR 0194."}, {"id": "vault_features_prepare_grid_editing", "label": "Beat grid editing", "file_type": "concept", "source_file": "vault/features/prepare.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BPM plus or minus 0.01, times 2, divide by 2, tap tempo, nudge the grid, Beat 1 here, Reset to analysis; saved on the track and renumbered so bar lines stay put."}], "edges": [{"source": "vault_features_prepare_feature", "target": "vault_features_prepare_dj_apps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "vault_features_prepare_vinyl_scrub", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "vault_features_prepare_kept_in_step", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "vault_features_prepare_grid_editing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "src_core_library_cueedit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "src_lib_bpm", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_prepare_feature", "target": "src_lib_metronome", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/prepare.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_pr