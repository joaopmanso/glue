{"nodes": [{"id": "vault_adr_0141_songs_get_their_own_port_and_a_read_looks_up_only_its_folder_decision", "label": "ADR 0141: Songs played get their own port, and a file read looks up only its own folder", "file_type": "rationale", "source_file": "vault/adr/0141-songs-get-their-own-port-and-a-read-looks-up-only-its-folder.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A sleeping disk (F: was idle), connection bottleneck (6 connections max to 127.0.0.1:47400), and NAS interference delayed song playback. Separating songs onto their own port (PLAY_PORT) prevents connection contention and avoiding full folder lookups prevents waking unused drives. Consequence: songs play without waiting on other loads, and local songs never wake network drives."}, {"id": "home_src_tauri_src_local_rs_code", "label": "home/src-tauri/src/local.rs", "file_type": "code", "source_file": "vault/adr/0141-songs-get-their-own-port-and-a-read-looks-up-only-its-folder.md", "source_location": "line 29", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "home_src_tauri_src_main_rs_code", "label": "home/src-tauri/src/main.rs", "file_type": "code", "source_file": "vault/adr/0141-songs-get-their-own-port-and-a-read-looks-up-only-its-folder.md", "source_location": "line 37", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_platform_homeDisk_ts_code", "label": "src/platform/homeDisk.ts", "file_type": "code", "source_file": "vault/adr/0141-songs-get-their-own-port-and-a-read-looks-up-only-its-folder.md", "source_location": "line 33", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_lib_localHome_svelte_ts_code", "label": "src/lib/localHome.svelte.ts", "file_type": "code", "source_file": "vault/adr/0141-songs-get-their-own-port-and-a-read-looks-up-only-its-folder.md", "source_location": "line 33", "source_url": null