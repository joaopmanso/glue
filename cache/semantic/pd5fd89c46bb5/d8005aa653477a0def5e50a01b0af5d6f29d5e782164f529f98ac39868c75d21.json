{"nodes": [{"id": "vault_system_document", "label": "SYSTEM.md: How GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md"}, {"id": "glue_website_concept", "label": "GLUE Website", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Svelte 5 + TypeScript app on GitHub Pages, works offline without account, static client-only"}, {"id": "glue_folder_concept", "label": "GLUE Folder", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "User's data in JSON files with no database, chosen on first run or kept in browser storage (OPFS), lowercase mco naming for backward compatibility"}, {"id": "glue_home_concept", "label": "GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Tauri 2 tray app (Windows, macOS) acting as library engine when running, analyzes songs, manages folder access, streams to other devices"}, {"id": "glue_cloud_concept", "label": "GLUE Cloud", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Optional Cloudflare Worker with D1 and Durable Object, holds account collections (never music), profiles, devices, signaling for WebRTC"}, {"id": "glue_folder_structure_concept", "label": "GLUE Folder File Structure", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "mco.json index, profiles/<pid>/profile.json, collections/<cid>/ with tracks, analysis, lists, sources, events, dupes, files, backups subdirectories"}, {"id": "profiles_concept", "label": "Profiles (Artist Aliases)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Artist aliases with id, name, colour, BPM range; account keeps union across devices, deleted profiles are final everywhere, each device picks its own lastAlias"}, {"id": "collections_concept", "label": "Collections", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Music folders, DJ libraries, songs, playlists, analyses, events; can be shared via cloud sync showing one row per song, best copy shown everywhere except Duplicates"}, {"id": "shared_collections_concept", "label": "Shared Collections", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Account collections synced via GLUE Cloud, snapshot and log in D1, same file on two computers is one song with copy on each, analyses stored per computer"}, {"id": "local_link_concept", "label": "Local Link: GLUE Home HTTP API", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "http://127.0.0.1:47400-47409 routes: /hello, /connect, /fs/*, /cache, /rpc, /lease, /attach, /incoming, /dock, /folders; token-gated except /hello and /connect"}, {"id": "analysis_system_concept", "label": "Analysis System", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Worker pool or GLUE Home analyzes songs (summary verdict, full details, fingerprint, spectrogram, waveform); ANALYSIS_VERSION 3, VERDICT_VERSION 5"}, {"id": "duplicates_concept", "label": "Duplicate Detection", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Three-tier detection via fingerprints (same recording) and artist+title (probable); only best copy shown everywhere except Duplicates; user can mark apart or manually duplicate"}, {"id": "quality_verdicts_concept", "label": "Quality Verdicts", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "rationale": "Hi-res judged by content past 24 kHz above silence, lossless by steep top-end with music-following content and no frequent drop-outs under 12%, verdict changes bump VERDICT_VERSION"}], "edges": [{"source": "vault_system_document", "target": "glue_website_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md"}, {"source": "vault_system_document", "target": "glue_folder_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md"}, {"source": "vault_system_document",