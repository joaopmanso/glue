{"nodes": [{"id": "vault_adr_0168_dj_apps_synced_both_ways_decision", "label": "ADR 0168: DJ apps synced both ways", "file_type": "rationale", "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home is the desktop era that allows safe write-back to DJ libraries: read live, write opt-in per library with backups before every write while the app is closed. Solves the user's need to prepare songs in GLUE and sync changes bidirectionally with Engine DJ, Rekordbox, Traktor and Serato."}, {"id": "vault_adr_0167_dj_libraries_in_glue_home_decision", "label": "ADR 0167: DJ libraries in GLUE Home", "file_type": "rationale", "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home reads DJ libraries in Rust and follows them live. Provides the foundation for bidirectional sync."}, {"id": "three_way_merge_mechanism", "label": "Three-way merge: bidirectional sync mechanism", "file_type": "rationale", "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home keeps state last synced with each library. Changes on one side since then go to the other; both sides' changes to different things are kept. Same cue/loop/grid/list changed on both sides is a clash, shown in GLUE to settle."}, {"id": "backup_before_write_safeguard", "label": "Backup before write: safeguard mechanism", "file_type": "rationale", "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every write into a DJ library is backed up first, opt-in per library, and tested on throwaway libraries before the user's, to prevent data loss from bugs."}, {"id": "app_closed_during_write_constraint", "label": "Write only when app closed: constraint", "file_type": "rationale", "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engine DJ and Rekordbox keep their libraries in memory and would overwrite changes. GLUE waits for the app to close before writing."}], "edges": [{"source": "vault_adr_0168_dj_apps_synced_both_ways_decision", "target": "vault_adr_0010_import_export_before_write_back_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0168_dj_apps_synced_both_ways_decision", "target": "vault_adr_0167_dj_libraries_in_glue_home_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0168_dj_apps_synced_both_ways_decision", "target": "three_way_merge_mechanism", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0168_dj_apps_synced_both_ways_decision", "target": "backup_before_write_safeguard", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0168_dj_apps_synced_both_ways_decision", "target": "app_closed_during_write_constraint", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0168-dj-apps-synced-both-ways.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0168_dj_apps_synced_both_ways_dec