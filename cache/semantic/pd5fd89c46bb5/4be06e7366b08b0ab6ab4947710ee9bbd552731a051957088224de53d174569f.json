{"nodes": [{"id": "vault_system_how_glue_works", "label": "SYSTEM.md: how GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_system_sets_section", "label": "SYSTEM.md section 6: Sets", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A playlist laid out as a mix on one beat clock, kept as List.set. planSet places hand-overs on phrases, fits a length, layers songs on 3 decks, places drops, and holds hand edits, undo and redo. ADRs 0199 to 0206."}, {"id": "vault_system_sets_who_mixes", "label": "Who mixes: GLUE Home or the browser", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home mixes the set whenever it runs and has every song (the same mixer ported to Rust and streamed to the tab for preview and file); otherwise the browser mixes. ADR 0204 supersedes ADR 0199's rendering in the browser."}, {"id": "vault_system_set_stream_glue_home", "label": "GLUE Home's set stream (/set/<id>/pcm)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The local link serves a set's mix as GLUE Home renders it: stereo f32 at 44.1 kHz, chunked (ADR 0204)."}], "edges": [{"source": "vault_system_how_glue_works", "target": "vault_system_sets_section", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_sets_section", "target": "vault_system_sets_who_mixes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confiden