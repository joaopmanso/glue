{"nodes": [{"id": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "label": "ADR 0183: Keep Engine DJ's folders as Engine DJ keeps them", "file_type": "document", "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE wrote every Engine DJ folder entry with reference 0 and never a folder's own entries, so folders in the Collection and its drives drifted from Engine DJ's rule (208 wrong references, 406 songs missing from folders on the Collection; 12,261 of 16,331 folder entries wrong on F:). Decision: after every sync with Engine DJ closed, GLUE Home repairs folders to Engine DJ's rule after a backup. Superseded by 0184 after Engine DJ locked every playlist."}, {"id": "engine_dj_folder_reference_rule", "label": "Engine DJ folder membership reference rule", "file_type": "rationale", "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A folder holds each song of its lists once, with membershipReference set to the number of its lists holding it; a folder can also hold songs of its own at reference 0. Read from copies of the databases (Tugaria: 449 own songs)."}, {"id": "enginedj_fix_folders", "label": "enginedj::fix_folders", "file_type": "code", "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The folder repair run after every Engine DJ sync; no longer called since 0.74.1 (ADR 0184), kept with its unit test."}, {"id": "folders_own", "label": "folders_own", "file_type": "code", "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In a drive's copy a folder's song stays only if the Collection's folder holds it as its own; otherwise it is a copy GLUE made and goes."}], "edges": [{"source": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "target": "vault_adr_0182_engine_dj_collection_and_its_drive_copies_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "target": "vault_adr_0180_glues_playlists_in_engine_djs_glue_folder_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "target": "vault_research_engine_dj_write_back_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "weight": 1.0}, {"source": "enginedj_fix_folders", "target": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "weight": 1.0}, {"source": "folders_own", "target": "vault_adr_0183_engine_dj_folders_kept_as_engine_dj_keeps_them_decision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0183-engine-dj-folders-kept-as-engine-dj-keeps-them.md", "source_location": null, "weight": 1.0}, {"source": "engine_dj_folder_reference_rule", "target": "vault_adr_0183_engine