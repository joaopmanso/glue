{"nodes": [{"id": "vault_features_sets_feature", "label": "Sets: a playlist mixed, exported as one file", "file_type": "document", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vault_features_sets_drop_planning", "label": "Hand-overs on each song's drop and the bass", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The incoming song comes in so its drop lands where the bass changes hands, so the playing song is never left without its bass during the next one's intro (ADR 0205)."}, {"id": "vault_features_sets_phrase_planning", "label": "Hand-overs on 16-bar phrases", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-overs fall on 16-bar phrases before each outro; songs whose tempos are more than 8 % apart are cut on the phrase instead (ADR 0200)."}, {"id": "vault_features_sets_three_decks_layering", "label": "Layering alike songs on 3 decks", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two songs in a row that sound alike, with close tempos and keys that fit, are layered: 48 bars along, then three at once for 16 bars; only one has its bass at a time (ADR 0202)."}, {"id": "vault_features_sets_timeline_follow", "label": "Timeline follows the playhead", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On while playing until the user zooms, scrolls or drags; the crosshair button by Play turns following on again (ADR 0207)."}, {"id": "vault_features_sets_mixed_by_glue_home", "label": "Set mixed by GLUE Home", "file_type": "concept", "source_file": "vault/features/sets.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With GLUE Home running (0.84 or later) it mixes the set from the disk and streams it to the page for the preview and the file; otherwise the browser mixes (ADR 0204)."}], "edges": [{"source": "vault_features_sets_feature", "target": "vault_adr_0197_a_sound_profile_for_every_song_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_adr_0198_playlists_that_follow_a_flow_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_adr_0199_a_set_is_a_playlist_mixed_by_one_engine_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_adr_0200_planning_a_set_on_phrases_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_adr_0201_a_set_shaped_by_hand_and_heard_live_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/sets.md", "source_location": null, "weight": 1.0}, {"source": "vault_features_sets_feature", "target": "vault_adr_0202_a_sets_length_layering_and_timeline_gestures_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/features/se