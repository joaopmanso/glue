{"nodes": [{"id": "vault_system_md_rationale", "label": "vault/SYSTEM.md: How GLUE works now", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth for GLUE's current architecture: must update when implementation changes; ADRs explain the why"}, {"id": "glue_folder_concept", "label": "GLUE folder: user's data", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON files, no database (ADR 0009). Chosen on first run or in OPFS on device with no folder. Internal prefix 'mco' preserved for backward compatibility."}, {"id": "glue_home_concept", "label": "GLUE Home: Tauri 2 tray app", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows and macOS tray app. When running, is the library engine and website on that computer is its screen (ADR 0104). Analyses natively in Rust, syncs shared collections, manages local link on 127.0.0.1:47400\u201347409."}, {"id": "glue_cloud_concept", "label": "GLUE Cloud: account and signaling service", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional Cloudflare Worker with D1 and Durable Object. Holds account's collections (never music), profiles, and devices. No library data in cloud unless cloud sync on."}, {"id": "website_concept", "label": "Website: Svelte 5 + TypeScript app", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Works alone offline without account. Deployed to https://joaopmanso.github.io/glue/. Routes: #/ library, #/track/<id>, #/events, #/analyze, #/help, #/admin."}, {"id": "shared_sync_concept", "label": "Shared sync: account's collections sync", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps shared collection in GLUE Cloud as snapshot and log of changes (ADR 0106). Three-way merge per field; for per-computer parts, computer's side wins (ADR 0107)."}, {"id": "profiles_feature", "label": "Profiles: artist aliases", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Artist aliases with id, name, colour, BPM range (ADRs 0113, 0114). Signed in, account keeps the list. One profile per GLUE folder. BPM range belongs to alias."}, {"id": "collections_feature", "label": "Collections: music folders, songs, playlists", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hold music folders, DJ libraries, songs, playlists, analyses, events. Signed in with cloud sync, every collection is the account's, one copy in GLUE Cloud."}, {"id": "analysis_feature", "label": "Analysis: quality, BPM, key detection", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In GLUE Home where it runs (natively, ADR 0148); otherwise in tab worker pool. Makes summary (verdict, bandwidth, bit depth, BPM, key), full details, fingerprint, mini spectrogram, waveform."}, {"id": "local_link_concept", "label": "Local link: GLUE Home HTTP on 127.0.0.1:47400\u201347409", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes: /hello, /connect, /fs/*, /cache, /rpc, /lease, /attach, /incoming, /dock, /folders (ADR 0048)."}], "edges": [{"source": "vault_system_md_rationale", "target": "glue_home_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "16", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "glue_folder_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "26", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "glue_cloud_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "17", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "website_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "14", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "shared_sync_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "112", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "profiles_feature", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "72", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "collections_feature", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "84", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "analysis_feature", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "238", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "local_link_concept", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "137", "weight": 1.0}, {"source": "glue_home_concept", "target": "crates_glue_engine_code", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "150", "weight": 1.0}, {"source": "glue_home_concept", "target": "crates_glue_rtc_code", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "181", "weight": 1.0}, {"source": "glue_home_concept", "target": "local_link_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "137", "weight": 1.0}, {"source": "glue_app_concept", "target": "glue_home_concept", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "22", "weight": 1.0}, {"source": "glue_app_concept", "target": "glue_cloud_concept", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "21", "weight": 1.0}, {"source": "vault_system_md_rationale", "target": "vault_adr_0155_the_shared_sync_in_rust_decision", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "112", "weight": 1.0}], "hyperedges": [{"id": "glue_architecture_hyperedge", "label": "GLUE website and GLUE Home form local-first DJ library", "nodes": ["website_concept", "glue_home_concept", "glue_folder_concept"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md"}]}