{"nodes": [{"id": "vault_system_document", "label": "GLUE: How It Works Now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_website_system", "label": "GLUE Website (Svelte 5 + TypeScript on GitHub Pages)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_folder_store", "label": "GLUE Folder: JSON Files Data Store", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON files in GLUE folder are the store (ADR 0009); no database. Profiles, collections, tracks, analysis, lists, sources, events, duplicates. Caches live in browser (OPFS) and GLUE Home, not in the folder."}, {"id": "glue_home_tauri_app", "label": "GLUE Home: Tauri 2 Tray App", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Home is the computer's library engine (ADR 0104): disk access, analysis pool, cloud sync, live DJ library follow. The website on that computer is its screen (ADR 0051)."}, {"id": "glue_cloud_service", "label": "GLUE Cloud: Cloudflare Worker with D1 and Durable Object", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional account service holding only the account's collections (never music), profiles, and devices. Signaling for WebRTC, TURN relay credentials, admin panel."}, {"id": "profile_system_concept", "label": "Profiles: Artist Aliases", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A profile is an artist alias (ADR 0113, 0114): id, name, colour, BPM range. Each device picks its own; signed in, the account keeps the union. One GLUE folder has one library that every alias opens."}, {"id": "collection_system_concept", "label": "Collections: Music Library and Shared Form", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A collection holds music folders, DJ libraries, songs, playlists, analyses, events. Signed in with cloud sync, every collection is the account's, shared in GLUE Cloud with one copy per song per computer (ADR 0101, 0130)."}, {"id": "analysis_system_concept", "label": "Analysis: Quality Verdicts and Duplicates", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs in a worker pool (src/lib/pool.ts), in GLUE Home where it runs, or the tab. Makes summary (verdict, tier, bandwidth, bit depth, BPM, key), full details, fingerprint, mini spectrogram, waveform. Verdicts from src/core/audio/verdict.ts checked against legacy parity."}, {"id": "local_rs_code_module", "label": "local.rs: GLUE Home's Local Link Implementation", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_platform_homesocket_ts", "label": "src/platform/homeSocket.ts: Socket for Background Loads", "file_type": "code", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_system_document", "target": "glue_website_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "glue_folder_store", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "glue_home_tauri_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "glue_cloud_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "profile_system_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "collection_system_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "analysis_system_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "glue_home_tauri_app", "target": "local_rs_code_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "vault_system_document", "target": "src_platform_homesocket_ts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": null, "weight": 1.0}, {"source": "glue_folder_store", "target": "collection_system_concept", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "v