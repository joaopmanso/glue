{"nodes": [{"id": "vault_system_md_document", "label": "SYSTEM.md: how GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "rationale": "Single place describing all pieces: website, GLUE folder, GLUE Home, GLUE Cloud; updated whenever how GLUE works changes"}, {"id": "glue_website_concept", "label": "Website: Svelte 5 + TypeScript app", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "glue_home_concept", "label": "GLUE Home: Tauri 2 tray app, library engine", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "When running, GLUE Home is the library engine and the website on that computer is its screen (ADR 0104)"}, {"id": "glue_cloud_concept", "label": "GLUE Cloud: optional account and signaling service", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "glue_folder_concept", "label": "GLUE folder: user's data, JSON files store", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Contains collections, songs, analysis, profiles; lowercase mco names are the real file names (from old name); data depends on them"}, {"id": "collection_store_concept", "label": "CollectionStore: in-memory store per collection", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "track_concept", "label": "Track: a song with metadata, status, and analysis", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "roots_concept", "label": "Roots: music folders with handles or GLUE Home links", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "profiles_concept", "label": "Profiles: artist aliases, local or account-wide", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "ADRs 0113, 0114: each device picks its own profile; profiles are the account's (signed in) or local to a GLUE folder"}, {"id": "collections_concept", "label": "Collections: music folders, songs, playlists, analyses, events", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "shared_form_concept", "label": "Shared form: collections in GLUE Cloud, synced across devices", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "ADRs 0101, 0106, 0107: shared collection as snapshot and log; per-computer copies tracked; merge3 per field; clashes wait in box"}, {"id": "sync_mechanism", "label": "Cloud sync: GLUE Home and tab push/pull, merge per file", "file_type": "rationale", "source_file": "vault/SYSTEM.md"}, {"id": "analysis_mechanism", "label": "Analysis: worker pool, quality verdicts, duplicates, stems", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "rationale": "analysisState returns: done, failed, waiting, elsewhere or nofile; verdict from forensics; hi-res by ultrasonic content; lossless by no dropouts (ADR 0119)"}, {"id": "duplicates_mechanism", "label": "Duplicates: three tiers, fingerprints and metadata matching", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "rationale": "Same recording by fingerprint, probable by artist+title within 3 s; user can mark apart or as duplicates; best copy shown (ADRs 0013, 0117, 0120)"}, {"id": "cache_mechanism", "label": "Caches: browser OPFS (analysis, thumbs, waveforms, covers) and GLUE Home (t, w, d, p, s)", "file_type": "rationale", "source_file": "vault/SYSTEM.md"}, {"id": "local_link_concept", "label": "Local link: http://127.0.0.1:47400\u201347409 to GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Routes for disk (/fs/*, /cache), engine (/rpc), lease, sessions; every route needs token except /hello and /connect (ADR 0048)"}, {"id": "service_page_concept", "label": "Service page: GLUE Home's engine work, analysis, sync, streaming", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "onscreen_mechanism", "label": "Rows on screen: held by song id, asked again if cancelled", "file_type": "rationale", "source_file": "vault/SYSTEM.md", "rationale": "ADR 0142: rows not held by track