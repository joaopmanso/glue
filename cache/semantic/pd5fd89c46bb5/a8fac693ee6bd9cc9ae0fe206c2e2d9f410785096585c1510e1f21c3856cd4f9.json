{"nodes": [{"id": "vault_system_md_system", "label": "GLUE system: how it works now", "file_type": "document", "source_file": "vault/SYSTEM.md"}, {"id": "vault_system_website_component", "label": "GLUE website component", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Svelte 5 + TypeScript app on GitHub Pages; works offline without an account; the main user interface"}, {"id": "vault_system_glue_folder_component", "label": "GLUE folder: user's data store", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "JSON files in user's chosen location; contains profiles, collections, tracks, analysis, lists, sources, events, backups; no database; localizes all music data"}, {"id": "vault_system_glue_home_component", "label": "GLUE Home: library engine and desktop app", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Tauri 2 tray app for Windows and macOS; when running, becomes the library's engine; website on that computer is its screen; streams songs to other devices; analyzes songs; writes metadata to files"}, {"id": "vault_system_glue_cloud_component", "label": "GLUE Cloud: optional account and sync", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Cloudflare Worker with D1 and Durable Object; optional account system; holds account's collections, profiles, devices; never holds music data; enables device pairing and syncing"}, {"id": "vault_system_profile_concept", "label": "Profile: artist alias", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Artist identifier with id, name, colour, BPM range; account keeps unified list across devices; each device chooses which to use"}, {"id": "vault_system_collection_concept", "label": "Collection: music folder and playlist database", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Contains music folders, DJ libraries, songs, playlists, analyses, events; stored in JSON files per collection; owns