{"nodes": [{"id": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "label": "ADR 0173: Engine DJ - what GLUE can't see stays where it is; one backup each time Engine DJ closes", "file_type": "rationale", "source_file": "vault/adr/0173-engine-dj-what-glue-cant-see-stays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When syncing Engine DJ playlists, GLUE should only merge entries it knows (songs of databases it has read). Entries from unplugged drives stay where they are. One backup per database close session to reach back three sessions instead of three syncs."}, {"id": "glue_interop_crate_code", "label": "crates/glue-interop", "file_type": "code", "source_file": "vault/adr/0173-engine-dj-what-glue-cant-see-stays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "restore_lists_rs_code", "label": "crates/glue-interop/examples/restore_lists.rs", "file_type": "code", "source_file": "vault/adr/0173-engine-dj-what-glue-cant-see-stays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "engine_dj_backup_strategy_concept", "label": "Engine DJ backup strategy", "file_type": "concept", "source_file": "vault/adr/0173-engine-dj-what-glue-cant-see-stays.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "target": "vault_adr_0171_engine_dj_playlists_kept_in_step_decision", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0173-engine-dj-what-glue-cant-see-stays.md", "source_location": null, "weight": 1.0}, {"source": "vault_adr_0173_engine_dj_what_glue_cant_see_stays_decision", "target": "vault_adr_0172_engine_dj_order_and_songs_kept_decision", "relation": "rationale_fo