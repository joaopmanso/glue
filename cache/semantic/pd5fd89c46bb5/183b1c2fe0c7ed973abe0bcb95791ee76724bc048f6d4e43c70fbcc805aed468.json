{"nodes": [{"id": "vault_adr_0157_one_analysis_pipeline_inside_its_number_decision", "label": "ADR 0157: One analysis pipeline inside its number", "file_type": "rationale", "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md", "rationale": "A folder is listed once and its music added as not yet analysed. The queue is the one way songs are read, in order: songs asked for now, new songs' tags, library's songs for analysis, and background tasks. Each write has its own temporary file to avoid collisions."}, {"id": "tag_reading_concept", "label": "Tag reading in queue", "file_type": "concept", "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}, {"id": "folder_listing_concept", "label": "Folder listing mechanism", "file_type": "concept", "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}], "edges": [{"source": "vault_adr_0157_one_analysis_pipeline_inside_its_number_decision", "target": "analysis_queue_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}, {"source": "vault_adr_0157_one_analysis_pipeline_inside_its_number_decision", "target": "tag_reading_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}, {"source": "vault_adr_0157_one_analysis_pipeline_inside_its_number_decision", "target": "folder_listing_concept", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}, {"source": "vault_adr_0157_one_analysis_pipeline_inside_its_number_decision", "target": "glue_home_concept", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/adr/0157-one-analysis-pipeline-inside-its-number.md"}, {"source": "folder_listing_concept", "target": "collect