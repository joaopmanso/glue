{"nodes": [{"id": "vault_features_downloads_feature", "label": "Downloads (feature, shipped M6)", "file_type": "document", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user's aim: remotely create a USB drive to play a DJ set. Saves songs as files, from this computer or through another computer's GLUE Home."}, {"id": "downloads_playlist_numbered_zip", "label": "Playlist zip: numbered folder in playlist order", "file_type": "rationale", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A player listing a folder by name keeps the set's order on a USB drive. A song in two playlists is in both."}, {"id": "downloads_byte_sources", "label": "Byte sources: file, incoming folder over local link, remote 4 MB ranges", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Remote ranges are asked again up to 5 times, and the connection is made again if it dropped, so a flaky link resumes instead of failing."}, {"id": "downloads_writing_modes", "label": "Writing: save dialog streams to disk, otherwise gathered Blobs", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chrome and Edge stream any size (ZIP64 past 4 GB); Firefox, Safari and phones gather in the browser, so they need room and suit smaller sets."}, {"id": "downloads_panel", "label": "Download panel: progress, waiting state, cancel, report", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progress counts bytes as they arrive, not when a 4 MB piece is whole. A failing song does not stop the rest; a full disk does. Closing the tab while running asks first."}, {"id": "downloads_transfer_rate", "label": "Speed and time left over the last 20 s", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No estimate until there are 2 s to go on, so the figure does not jump at the start."}, {"id": "downloads_remote_pull", "label": "remoteFiles.pull: fetching from another computer", "file_type": "code", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "downloads_usb_direct_folder", "label": "Saving straight into a USB folder (not yet asked for)", "file_type": "rationale", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Open item: would avoid the unzip step. Not built."}, {"id": "downloads_dj_usb_exports_separate", "label": "DJ-app USB exports (rekordbox, Engine DJ databases) are a separate feature", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This feature gives plain files, not DJ-app databases on the drive."}, {"id": "downloads_names_safe", "label": "Safe file names for Windows, FAT32 and exFAT, unique per folder", "file_type": "concept", "source_file": "vault/features/downloads.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each name is used once per folder, so a zip extracts without clashes on a USB drive."}], "edges": [{"source": "vault_features_downloads_feature", "target": "vault_adr_0193_down