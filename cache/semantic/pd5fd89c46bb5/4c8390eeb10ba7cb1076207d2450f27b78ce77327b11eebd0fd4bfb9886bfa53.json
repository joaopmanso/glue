{"nodes": [{"id": "vault_features_performance_feature", "label": "Performance", "file_type": "document", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "perf_panel", "label": "?perf performance panel", "file_type": "concept", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows collection open time, row list cost, saving, per-frame drawing, long frames and the last slow clicks and keys. Off unless ?perf or the pref mco.perf is set, so nothing is measured by default."}, {"id": "onscreen_retries", "label": "OnScreen and Retries", "file_type": "concept", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requests from another computer are asked until answered (ADR 0131); shared by thumbnails, waveforms and covers."}, {"id": "src_lib_onscreen", "label": "src/lib/onScreen.ts", "file_type": "code", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_lib_perf", "label": "src/lib/perf.ts", "file_type": "code", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rows_load_on_screen", "label": "Rows load what is on screen", "file_type": "rationale", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The table draws 12 rows beyond each edge; overviews, waveforms and covers are requested newest first, and a row that scrolls away drops its requests."}, {"id": "opening_progress", "label": "Opening progress card", "file_type": "rationale", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A card with a bar shows the step and files read while a collection opens (ADR 0177); files are read through the folder listing, 32 at a time."}, {"id": "perf_budgets", "label": "Performance budgets", "file_type": "rationale", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 50k tracks: open within 2 s, a switch or sort within 100 ms, search P95 within 50 ms, no frame over 50 ms while scrolling or analysing (ADR 0058). Enforced by e2e/perf.spec.ts with PERF_BUDGET=1."}, {"id": "narrow_window_freeze", "label": "Narrow-window freeze fix", "file_type": "rationale", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Below 800 px the library lost its fixed height and the table drew all 7,000 rows; the narrow layout keeps the height and the table never draws more rows than fit the window."}, {"id": "e2e_perf_spec", "label": "e2e/perf.spec.ts", "file_type": "code", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "e2e_narrow_spec", "label": "e2e/narrow.spec.ts", "file_type": "code", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "e2e_decode_spec", "label": "e2e/decode.spec.ts", "file_type": "code", "source_file": "vault/features/performance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tests_synthetic_test", "label": "tests/synthetic.test.ts", "file_type": "code", "source