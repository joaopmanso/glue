{"nodes": [{"id": "vault_system_document", "label": "SYSTEM.md: How GLUE works now", "file_type": "document", "source_file": "vault/SYSTEM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "glue_website_component", "label": "GLUE website", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Svelte 5 + TypeScript app on GitHub Pages; works offline, client-only, no server dependency"}, {"id": "glue_home_component", "label": "GLUE Home", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tauri 2 tray app on Windows and macOS; becomes the library engine when running; the website becomes its screen on that computer"}, {"id": "glue_cloud_component", "label": "GLUE Cloud", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional account service using Cloudflare Worker with D1 and Durable Object; holds account collections, profiles, devices; never stores music"}, {"id": "glue_folder_concept", "label": "GLUE folder", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User's data: JSON files organized by profiles, collections, tracks, analysis, lists, sources, events, duplicates, and backups; no database"}, {"id": "mco_json_structure_concept", "label": "MCO JSON structure", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal names use 'mco' prefix (mco.json, profiles/pid/profile.json, collections/cid/); data backwards-compatibility requires keeping these names"}, {"id": "track_concept", "label": "Track (song record)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A song with status (linked, missing, unlinked), file location (rootId + relPath), metadata (tags, info, rating), prep data (bpm, grid, cues), and DJ library sources"}, {"id": "profile_concept", "label": "Profile (artist alias)", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An artist alias with id, name, colour, BPM range; each device keeps its own choice; the account keeps the union across devices"}, {"id": "shared_collection_concept", "label": "Shared collection form", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When cloud sync is on, collections are the account's; songs have copies per computer; same file on two computers is one song with a copy on each; analyses stored per computer"}, {"id": "sync_engine_concept", "label": "Sync engine", "file_type": "concept", "source_file": "vault/SYSTEM.md", "source_location": "line 109", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GLUE Cloud keeps snapshot and log; devices pull, merge with merge3 per field, push again on clash; clashes wait in a box; only changed files are looked at every 30 minutes"}], "edges": [{"source": "vault_system_document", "target": "glue_website_component", "relation": "describes", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md", "source_location": "line 14", "weight": 1.0}, {"source": "vault_system_document", "target": "gl