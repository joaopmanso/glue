{"nodes": [{"id": "vault_system_md_document", "label": "vault/SYSTEM.md: How GLUE works", "file_type": "document", "source_file": "vault/SYSTEM.md"}, {"id": "glue_home_tray_app", "label": "GLUE Home: Tauri 2 tray app for disk and analysis engine", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "GLUE Home is the user's own program on their own computer; when it runs, the website uses it as its disk and engine over the local link. Implements the library engine in Rust."}, {"id": "glue_cloud_service", "label": "GLUE Cloud: Cloudflare Worker for optional accounts", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Optional account on Cloudflare Worker with D1 and Durable Object. Holds account collections (never music), profiles, and devices. Enables sync across devices."}, {"id": "website_svelte_app", "label": "Website: Svelte 5 + TypeScript app on GitHub Pages", "file_type": "concept", "source_file": "vault/SYSTEM.md"}, {"id": "glue_folder_json_store", "label": "GLUE folder: JSON files as the store", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "The user's data in JSON files, not a database. Uses lowercase 'mco' names (from GLUE's old name) for backward compatibility. Contains profiles, collections, tracks, analysis, lists, sources, events, backups."}, {"id": "local_link_mechanism", "label": "Local link: HTTP API on 127.0.0.1:47400\u201347409", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Direct link between website and GLUE Home on the same computer. Provides access to disk (/fs), cache, RPC engine, lease management, and WebRTC connectivity."}, {"id": "native_engine_rust", "label": "Native analysis engine: Rust port of JavaScript analysis", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "Line-for-line Rust port of src/core's analysis with JavaScript's numbers. Located in crates/glue-audio. Analyzes songs natively in GLUE Home."}, {"id": "profiles_and_library", "label": "Profiles: Artist aliases in GLUE", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "A profile is an artist alias (id, name, colour, BPM range). GLUE folder has one library with one profile folder. Signed in, account keeps the merged list across devices."}, {"id": "collections_concept", "label": "Collections: Music folder groups with metadata", "file_type": "concept", "source_file": "vault/SYSTEM.md", "rationale": "A collection contains music folders, DJ libraries, songs, playlists, analyses, and events. Signed in with cloud sync, every collection is the account's with shared form across computers."}, {"id": "synchronization_mechanism", "label": "Cloud sync: Shared collection sync to GLUE Cloud", "file_type": "mechanism", "source_file": "vault/SYSTEM.md", "rationale": "GLUE Cloud keeps snapshot and log; push is one log entry, otherwise device pulls, merges and pushes again. Only marked-changed files looked at. Clashes wait in a box. One sync per account."}, {"id": "src_store_collection_ts", "label": "src/store/collection.ts: JSON collection store", "file_type": "code", "source_file": "vault/SYSTEM.md"}, {"id": "home_ui_service_ts", "label": "home/ui/service.ts: GLUE Home service page", "file_type": "code", "source_file": "vault/SYSTEM.md"}, {"id": "vault_adr_0151_the_glue_window_decision", "label": "ADR 0151: GLUE window in GLUE Home", "file_type": "rationale", "source_file": "vault/SYSTEM.md"}], "edges": [{"source": "vault_system_md_document", "target": "glue_application", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md"}, {"source": "vault_system_md_document", "target": "glue_home_tray_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "vault/SYSTEM.md"}, {"source": "vault_system_md_document", "target": "glue_cloud_service", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f